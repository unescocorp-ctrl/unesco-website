---
import { url } from '../utils/url';
import { mainNav } from '../data/navigation';
import { contact, telHref } from '../data/contact';
import Icon from './Icon.astro';
---
<div class="topbar"><span class="hide-sm"><Icon name="sparkles" /><b>UNESCO AI</b> – Kế toán chủ động, dữ liệu đáng tin cậy.<a class="more" href={url('/san-pham/unesco-xi-ai/')}>Tìm hiểu thêm →</a></span><span class="sep hide-sm">|</span><span>Kinh doanh<span class="hide-sm"> – Zalo</span>: <a href={telHref(contact.sales.mobile)}>{contact.sales.mobile}</a><span class="sep">·</span>Hỗ trợ: <a href={telHref(contact.support.phone)}>{contact.support.phone}</a></span></div>
<header class="header">
  <div class="container nav">
    <a class="brand" href={url('/')} aria-label="UNESCO AI - Trang chủ">
      <img class="brand-logo" src={url('/brand/unesco-star.png')} alt="" width="48" height="48" />
      <span class="brand-copy"><span>UNESCO <b>AI</b></span><small>PHẦN MỀM KẾ TOÁN DOANH NGHIỆP</small></span>
    </a>
    <nav class="nav-links" aria-label="Điều hướng chính">
      {mainNav.map((g) => g.items ? (
        <div class="nav-item has-sub">
          <a href={url(g.href)} aria-haspopup="true">{g.label}<span class="caret" aria-hidden="true"></span></a>
          <div class="sub">{g.items.map((it) => <a href={url(it.href)}><Icon name={it.icon} />{it.label}</a>)}</div>
        </div>
      ) : (
        <div class="nav-item"><a href={url(g.href)}>{g.label}</a></div>
      ))}
    </nav>
    <div class="nav-cta">
      <a class="btn btn-secondary" href={url('/download/')}>Tải phần mềm</a>
      <a class="btn btn-primary" href={url('/lien-he/#demo')}>Đăng ký demo</a>
      <button class="menu-btn" id="menuButton" type="button" aria-label="Mở menu" aria-expanded="false">☰</button>
    </div>
  </div>
  <div class="container mobile-panel" id="mobilePanel">
    {mainNav.map((g) => (
      <div class="m-grp"><b>{g.label}</b>{(g.items ?? [{ label: g.label, href: g.href, icon: '' }]).map((it) => <a href={url(it.href)}>{it.label}</a>)}</div>
    ))}
    <a class="btn btn-primary" href={url('/lien-he/#demo')}>Đăng ký xem demo</a>
  </div>
</header>
<script is:inline>
  const b=document.getElementById('menuButton'),p=document.getElementById('mobilePanel');
  b?.addEventListener('click',()=>{const open=p?.classList.toggle('open')??false;b.setAttribute('aria-expanded',String(open));b.textContent=open?'✕':'☰';});
</script>
