---
import { url } from '../utils/url';
import { mainNav } from '../data/navigation';
import { contact, telHref } from '../data/contact';
---
<div class="topbar"><span class="hide-sm">UNESCO AI · Phần mềm kế toán tích hợp AI</span><span class="sep hide-sm">|</span>Kinh doanh: <a href={telHref(contact.sales.mobile)}>{contact.sales.mobile}</a><span class="sep">·</span>Hỗ trợ: <a href={telHref(contact.support.phone)}>{contact.support.phone}</a></div>
<header class="header">
  <div class="container nav">
    <a class="brand" href={url('/')} aria-label="UNESCO AI - Trang chủ">
      <span class="brand-mark">U</span>
      <span class="brand-copy"><span>UNESCO AI</span><small>ACCOUNTING SOFTWARE</small></span>
    </a>
    <nav class="nav-links" aria-label="Điều hướng chính">
      {mainNav.map(item => <a href={url(item.href)}>{item.label}</a>)}
    </nav>
    <div class="nav-cta">
      <a class="btn btn-secondary" href={url('/download/')}>Tải phần mềm</a>
      <a class="btn btn-primary" href={url('/lien-he/#demo')}>Xem demo</a>
      <button class="menu-btn" id="menuButton" type="button" aria-label="Mở menu" aria-expanded="false">☰</button>
    </div>
  </div>
  <div class="container mobile-panel" id="mobilePanel">
    {mainNav.map(item => <a href={url(item.href)}>{item.label}</a>)}
    <a href={url('/lien-he/#demo')}><strong>Đăng ký xem demo</strong></a>
  </div>
</header>
<script is:inline>
  const b=document.getElementById('menuButton'),p=document.getElementById('mobilePanel');
  b?.addEventListener('click',()=>{const open=p?.classList.toggle('open')??false;b.setAttribute('aria-expanded',String(open));b.textContent=open?'✕':'☰';});
</script>
