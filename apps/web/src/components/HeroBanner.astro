---
/**
 * BANNER CHÍNH TRANG CHỦ – UNESCO XI + AI (theo code + hình mẫu UNESCO_TOPBAR_HERO_CODE, 09/10/2026)
 * Chữ là HTML thật, font Be Vietnam Pro (Google Fonts). Màn hình trong laptop là màn hình chính UNESCO AI thật.
 * Dải "Kế thừa giao diện quen thuộc" nằm ngay dưới banner (màn hình UNESCO đời cũ).
 * v2.6.1: nội dung banner nằm trong khung trang (.container 1200px) – thẳng mép với logo, menu và các mục bên dưới.
 * v2.7: thêm dòng cập nhật tự động version cũ / version đặc thù, biểu mẫu Bộ Tài chính, 4 thông tư; dòng trả phí dời xuống sát mép dưới.
 * v2.7.1: nhãn "Phần mềm offline…" dời xuống ngay dưới câu "AI có thể nhanh…".
 * v2.7.2: chữ UNESCO AI (ảnh 3D, nền trong suốt – public/banner/chu-unesco-ai.webp) đặt trên tiêu đề.
 */
import { url } from '../utils/url';
import Icon from './Icon.astro';
const tiles = [
  { icon: 'file-text', t: 'Hoá đơn', t2: 'điện tử', c: 'g', href: '/ai-ke-toan/ai-hoa-don/' },
  { icon: 'bank', t: 'Sổ phụ', t2: 'ngân hàng', c: 'b', href: '/ai-ke-toan/ai-so-phu-ngan-hang/' },
  { icon: 'settings', t: 'Giá thành', t2: '', c: 'y', href: '/ai-ke-toan/ai-gia-thanh/' },
  { icon: 'bar-chart', t: 'Thuế &', t2: 'báo cáo', c: 't', href: '/to-khai-bctc/' },
];
const versions = ['1.99', '2.04', '4.8', '5.1', '6.0', '7.1'];
const circulars = [
  { no: '99/2025/TT-BTC', c: 'b', href: '/to-khai-bctc/' },
  { no: '133/2016/TT-BTC', c: 'g', href: '/to-khai-bctc/' },
  { no: '58/2026/TT-BTC', c: 'r', href: '/huong-dan/#hd-23' },
  { no: '152/2025/TT-BTC', c: 'y', href: '/huong-dan/#hd-24' },
];
const legacy = [
  { img: 'unesco-classic-1999', t: 'Kế toán UNESCO', y: '1999' },
  { img: 'unesco-frm-net', t: 'UNESCO FRM.NET XII', y: '2012' },
  { img: 'unesco-xi', t: 'UNESCO XI', y: 'Thế hệ trước' },
];
---
<section class="hx" aria-labelledby="hx-title">
  <span class="hx-glow g1" aria-hidden="true"></span><span class="hx-glow g2" aria-hidden="true"></span>
  <div class="container hx-wrap">
    <div class="hx-grid">
      <div class="hx-copy">
        <p class="hx-logo"><img src={url('/banner/chu-unesco-ai.webp')} width="663" height="122" alt="UNESCO AI" decoding="async" /></p>
        <h1 id="hx-title" class="hx-title">
          <span class="ln"><span class="dk">Hiểu việc – nhắc việc</span> <span class="bl">kế toán</span></span>
          <span class="ln"><span class="dk">Làm thay phần việc</span> <span class="gr">kế toán</span></span>
          <span class="ln"><span class="bl">Kế toán</span> <span class="dk">kiểm soát và xác nhận</span></span>
        </h1>
        <p class="hx-trust"><span class="sh"><Icon name="shield-check" /></span><b>AI có thể nhanh, nhưng số liệu kế toán không được mất kiểm soát.</b></p>
        <p class="hx-pill"><Icon name="shield-check" /><b>Phần mềm offline dữ liệu linh hoạt – bảo mật</b></p>
        <div class="hx-cta">
          <a class="hx-btn dl" href={url('/download/')}><Icon name="download" />Tải phần mềm</a>
          <a class="hx-btn demo" href={url('/lien-he/#demo')}>Đăng ký demo<Icon name="chevron-right" /></a>
        </div>
      </div>
      <div class="hx-visual">
        <div class="hx-float" aria-hidden="true"><span><Icon name="bar-chart" /></span><span class="ai"><Icon name="cpu" /><b>AI</b></span><span><Icon name="file-text" /></span></div>
        <div class="hx-laptop">
          <div class="hx-screen"><img src={url('/screenshots/man-hinh-chinh-unesco-ai.webp')} width="1536" height="1024" alt="Màn hình chính phần mềm kế toán UNESCO XI + AI" fetchpriority="high" /></div>
          <div class="hx-base" aria-hidden="true"></div>
        </div>
        <ul class="hx-tiles">
          {tiles.map((x) => <li><a class={`c-${x.c}`} href={url(x.href)}><span class="ti"><Icon name={x.icon} /></span><b>{x.t}{x.t2 && <br />}{x.t2}</b><Icon name="chevron-right" class="go" /></a></li>)}
        </ul>
      </div>
    </div>
    <div class="hx-more">
      <div class="hx-ver"><p class="hx-ver-t">Cập nhật tự động các version cũ</p><p class="hx-ver-n">{versions.map((v) => <span>{v}</span>)}</p></div>
      <div class="hx-spec"><span class="chev" aria-hidden="true"><Icon name="chevron-right" /><Icon name="chevron-right" /><Icon name="chevron-right" /></span><p><b>Ver đặc thù:</b><span>Sông Đà • Hàng Hải • MISU</span></p></div>
      <div class="hx-forms"><span class="hx-doc" aria-hidden="true"><Icon name="file-text" /></span><p><b>Cập nhật đầy đủ biểu mẫu sổ sách báo cáo</b><span>Theo quy định mới nhất của Bộ Tài chính</span></p></div>
      <ul class="hx-tt" aria-label="Chế độ kế toán theo thông tư">
        {circulars.map((x) => <li><a class={`c-${x.c}`} href={url(x.href)}><span class="ti"><Icon name="file-text" /></span><span class="tx"><small>Thông tư</small><b>{x.no}</b></span></a></li>)}
      </ul>
    </div>
    <p class="hx-gold"><span>Trả phí 1 lần sử dụng mãi mãi – Không phí hàng năm</span></p>
  </div>
</section>
<section class="hx-legacy" aria-label="Kế thừa giao diện quen thuộc">
  <div class="container hx-legacy-in">
    <div class="hx-legacy-h"><b><span aria-hidden="true">»</span> Kế thừa giao diện quen thuộc</b><span>Từ năm 1999 đến UNESCO XI + AI</span><a href={url('/ban-quyen/#lich-su')}>Lịch sử sản phẩm →</a></div>
    <div class="hx-legacy-row">
      {legacy.map((x) => <figure><img src={url(`/banner/${x.img}.webp`)} width="560" height="350" alt={`Giao diện ${x.t} (${x.y})`} loading="lazy" decoding="async" /><figcaption><b>{x.t}</b><span>{x.y}</span></figcaption></figure>)}
    </div>
  </div>
</section>
