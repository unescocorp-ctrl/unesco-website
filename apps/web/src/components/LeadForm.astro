---
import { site, isPlaceholder } from '../config/site.config';
const { kind='lead', heading='Đăng ký tư vấn' } = Astro.props;
const contactEmail = isPlaceholder(site.company.email) ? '' : site.company.email;
---
<div class="card" id={kind==='demo'?'demo':undefined}>
  <h2 style="font-size:2rem">{heading}</h2><p class="muted">Chọn đúng nhu cầu để bộ phận phụ trách chuẩn bị nội dung tư vấn hoặc demo phù hợp, tránh mất thời gian của bạn.</p>
  <form id={`lead-${kind}`} data-kind={kind}>
    <div class="form-grid">
      <div class="field"><label for={`${kind}-name`}>Họ tên *</label><input id={`${kind}-name`} name="fullName" required maxlength="120" autocomplete="name"/></div>
      <div class="field"><label for={`${kind}-company`}>Doanh nghiệp</label><input id={`${kind}-company`} name="companyName" maxlength="200" autocomplete="organization"/></div>
      <div class="field"><label for={`${kind}-phone`}>Điện thoại *</label><input id={`${kind}-phone`} name="phone" required maxlength="30" autocomplete="tel" inputmode="tel"/></div>
      <div class="field"><label for={`${kind}-email`}>Email</label><input id={`${kind}-email`} name="email" type="email" maxlength="200" autocomplete="email"/></div>
      <div class="field full"><label for={`${kind}-interest`}>Nhu cầu *</label><select id={`${kind}-interest`} name="interestCode" required><option value="">Chọn nhu cầu</option><option value="UNESCO_XI_AI">UNESCO XI + AI</option><option value="KE_TOAN_DICH_VU">Giải pháp kế toán dịch vụ</option><option value="AI_HOA_DON">AI hóa đơn điện tử</option><option value="AI_SO_PHU">AI sổ phụ ngân hàng</option><option value="GIA_THANH">Tính giá thành</option><option value="SAN_XUAT">Giải pháp sản xuất</option><option value="XAY_DUNG">Giải pháp xây dựng</option><option value="KHAC">Nhu cầu khác</option></select></div>
      <div class="field full"><label for={`${kind}-message`}>Ghi chú</label><textarea id={`${kind}-message`} name="message" maxlength="2000"></textarea></div>
      <div class="field full"><label><input name="consent" type="checkbox" required/> Tôi đồng ý để doanh nghiệp sử dụng thông tin đã cung cấp nhằm liên hệ và xử lý yêu cầu theo Chính sách Bảo vệ dữ liệu cá nhân.</label></div>
    </div>
    <div class="actions" style="margin-top:18px"><button class="btn btn-primary" type="submit">GỬI YÊU CẦU</button></div><div class="form-status" role="status" aria-live="polite"></div>
  </form>
</div>
<script is:inline define:vars={{ apiBase: site.apiUrl, contactEmail }}>
  // apiBase rỗng = chưa có API (ví dụ website chạy trên GitHub Pages): không gửi đi đâu cả,
  // chuyển sang mở email (nếu đã cấu hình) hoặc hướng dẫn liên hệ trực tiếp.
  document.querySelectorAll('form[data-kind]').forEach(form=>{
    if(form.dataset.bound) return; form.dataset.bound='1';
    form.addEventListener('submit',async e=>{
      e.preventDefault(); const f=e.currentTarget, s=f.querySelector('.form-status');
      const data=Object.fromEntries(new FormData(f).entries()); data.source='website'; data.landingPage=location.pathname; data.requestType=f.dataset.kind;
      if(!apiBase){
        if(contactEmail){
          const body=['Họ tên: '+(data.fullName||''),'Doanh nghiệp: '+(data.companyName||''),'Điện thoại: '+(data.phone||''),'Email: '+(data.email||''),'Nhu cầu: '+(data.interestCode||''),'Ghi chú: '+(data.message||''),'Trang: '+location.href].join('\n');
          location.href='mailto:'+contactEmail+'?subject='+encodeURIComponent('[Website] Yêu cầu '+(data.requestType==='demo'?'xem demo':'tư vấn')+' – '+(data.fullName||''))+'&body='+encodeURIComponent(body);
          s.textContent='Đã mở ứng dụng email để bạn gửi yêu cầu.';
        } else {
          s.textContent='Chức năng gửi trực tuyến đang được cập nhật. Vui lòng liên hệ trực tiếp qua thông tin tại trang Liên hệ.';
        }
        return;
      }
      s.textContent='Đang gửi...';
      try{const r=await fetch(`${apiBase}/leads`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});if(!r.ok) throw new Error('request_failed');s.textContent='Đã tiếp nhận yêu cầu. Cảm ơn bạn.';f.reset();}
      catch{ s.textContent='Chưa gửi được yêu cầu. Vui lòng sử dụng thông tin liên hệ công bố trên website.'; }
    });
  });
</script>
