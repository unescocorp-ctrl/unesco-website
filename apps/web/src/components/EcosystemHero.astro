---
/** Hero ánh kim theo hình tham chiếu của chủ website. Phần còn lại của trang chủ giữ nguyên. */
import { url } from '../utils/url';
import Icon from './Icon.astro';

const artwork = '/banner/unesco-ecosystem-metallic-reference.png';
const cards = [
  { name: 'SalesCRM AI', label: 'UNESCO SalesCRM AI', icon: 'users', tone: 'rose', href: '/san-pham/salescrm/', x: 55, y: 516, w: 306, h: 180,
    points: ['Tìm kiếm khách hàng', 'Báo giá và ký hợp đồng', 'Chăm sóc khách hàng'] },
  { name: 'ERP_UNESCO', label: 'ERP_UNESCO', icon: 'bar-chart', tone: 'blue', href: '/san-pham/erp-unesco/', x: 439, y: 516, w: 294, h: 180,
    points: ['Phân công công việc', 'Theo dõi tiến độ', 'Quản lý nhân sự và lương'] },
  { name: 'UNESCO XII AI', label: 'UNESCO XII AI', icon: 'cpu', tone: 'green', href: '/unesco-xii-ai/huong-dan/', x: 807, y: 514, w: 295, h: 182,
    points: ['Hạch toán chứng từ', 'Đối chiếu số liệu', 'Lập báo cáo kế toán'] },
  { name: 'UNESCO TAX Online', label: 'UNESCO_TAX_Online', icon: 'file-text', tone: 'violet', href: '/san-pham/#unesco-tax-online', x: 1182, y: 514, w: 300, h: 182,
    points: ['Kê khai thuế', 'Theo dõi nghĩa vụ thuế', 'Lưu trữ hồ sơ thuế'] },
];
const benefits = [
  { icon: 'settings', name: 'Tự động hóa' },
  { icon: 'layers', name: 'Minh bạch tiến độ' },
  { icon: 'shield-check', name: 'Kiểm soát chất lượng' },
  { icon: 'database', name: 'Truy xuất dữ liệu' },
];
---
<section class="metal-hero" aria-labelledby="home-title">
  <div class="metal-container">
    <div class="metal-heading">
      <h1 id="home-title">
        <span class="metal-title-line"><span class="metal-text-emerald">Quy trình</span> <span class="metal-text-blue">AI</span> <span class="metal-text-gold">hỗ trợ</span></span>
        <span class="metal-subtitle-line">Vận hành toàn diện <span class="metal-text-gold">công ty dịch vụ kế toán</span></span>
        <span class="metal-ecosystem-line">Bằng hệ sinh thái <span>UNESCO AI</span></span>
      </h1>
      <div class="metal-art metal-ai-art" style="--sx:998;--sy:84;--sw:518;--sh:318" aria-hidden="true">
        <img src={url(artwork)} alt="" width="1536" height="1024" fetchpriority="high" />
      </div>
    </div>

    <ol class="metal-cards" aria-label="Bốn phần mềm trong quy trình vận hành">
      {cards.map((card, index) => (
        <li class={`metal-card metal-${card.tone}`}>
          <a class="metal-card-link" href={url(card.href)} aria-label={`Khám phá ${card.label}`}>
            <div class="metal-card-head"><span class="metal-icon"><Icon name={card.icon} /></span><h2>{card.name}</h2></div>
            <div class="metal-card-body">
              <div class="metal-art metal-card-art" style={`--sx:${card.x};--sy:${card.y};--sw:${card.w};--sh:${card.h}`} aria-hidden="true">
                <img src={url(artwork)} alt="" width="1536" height="1024" />
              </div>
              <ul class="metal-points">{card.points.map((point) => <li><span class="metal-check"><Icon name="check" /></span><span>{point}</span></li>)}</ul>
            </div>
          </a>
          {index < cards.length - 1 && <span class="metal-next" aria-hidden="true"><Icon name="arrow-right" /></span>}
        </li>
      ))}
    </ol>

    <ul class="metal-benefits" aria-label="Lợi ích của hệ sinh thái UNESCO">
      {benefits.map((benefit) => <li><Icon name={benefit.icon} /><span>{benefit.name}</span></li>)}
    </ul>

    <div class="metal-cta">
      <div class="metal-offer"><span aria-hidden="true">1<i>+</i>5</span><div><strong>Mua 1, tặng kèm 5 sản phẩm</strong><small>Sử dụng vĩnh viễn</small></div></div>
      <div class="metal-actions">
        <a class="home-button home-button-primary" href="#tu-van">Khám phá cùng chuyên gia<Icon name="chevron-right" /></a>
        <a class="home-button home-button-outline" href="#video-gioi-thieu"><Icon name="play" />Xem phần mềm</a>
      </div>
    </div>
    <p class="metal-note">Sơ đồ mô hình hỗ trợ – liên thông cần xác minh theo phiên bản. Hình ảnh mang tính minh hoạ.</p>
  </div>
</section>

<style>
.metal-hero{position:relative;isolation:isolate;overflow:hidden;padding:28px 0 25px;background:radial-gradient(ellipse at 76% 4%,#b9f0e9b3,transparent 42%),radial-gradient(ellipse at 23% 25%,#dcf8ed99,transparent 40%),linear-gradient(155deg,#fff 9%,#f3fcfc 38%,#fff 65%);color:#073c26}
.metal-hero:before{content:"";position:absolute;z-index:-1;width:120%;height:340px;top:-200px;left:-10%;border-radius:50%;border-bottom:42px solid #ffffff42;transform:rotate(-12deg);pointer-events:none}
.metal-container{width:min(1500px,calc(100% - 64px));margin-inline:auto}
.metal-heading{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 29%;align-items:center;gap:14px;min-height:265px;margin-bottom:28px}
.metal-heading h1{position:relative;z-index:1;margin:0;padding:10px 0 24px;font-family:"Be Vietnam Pro","Roboto",Arial,sans-serif;font-weight:900;line-height:1.34;letter-spacing:-.035em;text-transform:uppercase;text-wrap:initial;color:#083e27}
.metal-heading h1:after{content:"";display:block;width:104px;height:6px;margin-top:23px;border-radius:8px;background:linear-gradient(90deg,#04c620,#39cb00)}
.metal-title-line,.metal-subtitle-line,.metal-ecosystem-line{display:block}
.metal-title-line{font-size:clamp(30px,4.1vw,63px);line-height:1.2;margin-bottom:10px;white-space:nowrap}
.metal-title-line>span{display:inline-block}
.metal-subtitle-line{font-size:clamp(18px,2.1vw,32px);line-height:1.45}
.metal-ecosystem-line{font-size:clamp(23px,2.6vw,40px);margin-top:5px}
.metal-ecosystem-line>span{color:#14b80b;font-size:1.13em;font-weight:900;text-shadow:0 1px #efffba}
.metal-text-emerald,.metal-text-blue,.metal-text-gold{-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-stroke:.4px #064022;filter:drop-shadow(0 2px 0 #06371b) drop-shadow(0 3px 2px #003d3040)}
.metal-text-emerald{background-image:linear-gradient(174deg,#003a0c 1%,#2fff92 19%,#effff6 26%,#00bb43 35%,#006323 48%,#002f11 54%,#09d84c 76%,#00450b 100%)}
.metal-text-blue{background-image:linear-gradient(170deg,#00328f 1%,#1da7ff 19%,#c2eeff 28%,#007cfa 38%,#00358e 54%,#006efa 79%,#001f67 100%);-webkit-text-stroke-color:#093d78;filter:drop-shadow(0 2px 0 #002255) drop-shadow(0 3px 2px #00398340)}
.metal-text-gold{background-image:linear-gradient(173deg,#9d5900 0%,#ffe049 17%,#fffbd2 28%,#ffcb10 40%,#a65f00 53%,#ffdb2e 76%,#8a4a00 100%);-webkit-text-stroke-color:#976100;filter:drop-shadow(0 2px 0 #805000) drop-shadow(0 3px 2px #8a570035)}
.metal-subtitle-line .metal-text-gold{-webkit-text-stroke-width:.2px;filter:drop-shadow(0 1px 0 #805000) drop-shadow(0 2px 1px #8a570030)}
.metal-subtitle-line>.metal-text-gold,.metal-ecosystem-line>span{padding-inline-start:.15em}
@media(max-width:580px){.metal-subtitle-line>.metal-text-gold{padding-inline-start:0}}
/* Chỉ hiển thị phần minh hoạ, giữ nguyên tệp ảnh tham chiếu. */
.metal-art{position:relative;aspect-ratio:var(--sw)/var(--sh);overflow:hidden;pointer-events:none}
.metal-art>img{position:absolute;display:block;width:calc(153600% / var(--sw));height:auto;max-width:none;left:calc(var(--sx) * -100% / var(--sw));top:calc(var(--sy) * -100% / var(--sh))}
.metal-ai-art{width:115%;margin-left:-6%;mask-image:linear-gradient(90deg,transparent,#000 6%,#000 96%,transparent),linear-gradient(0deg,transparent,#000 8%,#000 94%,transparent);mask-composite:intersect}
.metal-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px;list-style:none;margin:0;padding:0}
.metal-card{position:relative;min-width:0;--solid:#a72b31;--deep:#6b171d;--shine:#ffc9c2;--soft:#fff1f0;border:2px solid var(--deep);border-radius:21px;background:var(--soft);box-shadow:0 3px 0 var(--deep),0 8px 16px #193d2a1f,inset 0 0 0 2px #fff;transition:transform .2s,box-shadow .2s}
.metal-rose{--solid:#bf4a44;--deep:#983d39;--shine:#ffd1cb;--soft:#fff3f2}
.metal-blue{--solid:#0065ee;--deep:#003ea6;--shine:#85dbff;--soft:#eef6ff}
.metal-green{--solid:#00ba28;--deep:#006210;--shine:#96ff71;--soft:#006b13;background:radial-gradient(ellipse at 10% 15%,#63fb22,transparent 35%),repeating-linear-gradient(140deg,#ffffff06 0 1px,#ffffff00 2px 6px),linear-gradient(125deg,#00840d,#003c13 58%,#008422);box-shadow:0 3px 0 #00781d,0 0 0 3px #b9f876,0 8px 18px #0cc03635}
.metal-violet{--solid:#8d26dd;--deep:#661ca7;--shine:#edbaff;--soft:#f7efff}
.metal-card-link{display:flex;flex-direction:column;height:100%;border-radius:19px;color:#101814;text-decoration:none;overflow:hidden}
.metal-card-head{position:relative;isolation:isolate;display:flex;align-items:center;gap:12px;min-height:85px;padding:15px 16px;border-radius:18px 18px 11px 11px;border:1px solid #ffffffd9;border-bottom-color:var(--deep);background:repeating-linear-gradient(137deg,#ffffff0e 0 1px,transparent 1px 4px),linear-gradient(123deg,transparent 18%,#ffffffa6 25%,transparent 36%,#ffffff26 62%,transparent 73%),linear-gradient(168deg,var(--deep),var(--shine) 14%,var(--solid) 25%,var(--deep) 53%,var(--solid) 78%,var(--shine));box-shadow:inset 0 2px 3px #fff,inset 0 -3px 7px #0004,0 2px 3px #0002}
.metal-card-head h2{position:relative;margin:0;color:#fff;font-size:clamp(16px,1.7vw,27px);letter-spacing:-.035em;line-height:1.16;font-weight:850;text-wrap:initial;text-shadow:0 2px 2px #0009}
.metal-icon{display:grid;place-items:center;flex:none;width:49px;height:54px;border-radius:14px;color:white;border:1px solid #fff9;background:linear-gradient(145deg,#ffffff7d,transparent 45%,#0005);box-shadow:inset 0 1px 1px #fff,0 2px 3px #0007}
.metal-icon :global(.i){width:32px;height:32px;filter:drop-shadow(0 2px 1px #0006)}
.metal-green .metal-icon{color:#075618;background:linear-gradient(130deg,#efffb6,#b7f453 45%,#77cf12);border-color:#dfff93;box-shadow:inset 0 2px 2px #fff,0 2px 4px #002e0d}
.metal-green .metal-icon :global(.i){filter:none}
.metal-card-body{display:flex;flex:1;flex-direction:column;padding:8px 16px 24px}
.metal-card-art{width:100%;margin:0 auto 4px;mask-image:linear-gradient(0deg,transparent,#000 8%,#000 96%,transparent)}
.metal-points{display:flex;flex-direction:column;gap:14px;list-style:none;padding:17px 2px 0;margin:0;border-top:1px solid color-mix(in srgb,var(--solid) 23%,transparent);font-size:clamp(13px,1.4vw,21px);font-weight:650;line-height:1.45;letter-spacing:-.03em}
.metal-points>li{display:flex;align-items:flex-start;gap:10px;min-width:0}
.metal-check{display:grid;place-items:center;flex:none;width:25px;height:25px;margin-top:2px;color:#fff;border:1px solid var(--deep);border-radius:50%;background:linear-gradient(145deg,#fff 0%,var(--shine) 17%,var(--solid) 45%,var(--deep) 72%,var(--solid));box-shadow:inset 0 1px 0 #fff,0 2px 3px #0003}
.metal-check :global(.i){width:18px;height:18px;stroke-width:3;filter:drop-shadow(0 1px 0 #0004)}
.metal-green .metal-points{color:#fff;border-color:#acfa7d70;text-shadow:0 1px 2px #00240f}
.metal-green .metal-check{--solid:#36ca03;--shine:#d0ff4e;--deep:#075e06}
.metal-next{position:absolute;z-index:2;right:-28px;top:43%;display:grid;place-items:center;width:25px;height:30px;color:#0aab18;filter:drop-shadow(0 1px #fff)}
.metal-next :global(.i){width:27px;height:27px;stroke-width:3}
.metal-card:hover{transform:translateY(-4px);box-shadow:0 5px 0 var(--deep),0 12px 22px #173b292b}
.metal-card-link:focus-visible{outline:3px solid #173b84;outline-offset:6px}
.metal-benefits{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin:40px 0 0;padding:24px 15px;border:1px solid #fff;border-radius:23px;background:linear-gradient(120deg,#f0f9fe,#f5fcff 60%,#eaf6fd);box-shadow:inset 0 1px 0 #fff;color:#092d17}
.metal-benefits>li{display:flex;align-items:center;justify-content:center;gap:16px;padding:0 15px;font-size:clamp(15px,1.75vw,25px);font-weight:750;line-height:1.4;letter-spacing:-.04em}
.metal-benefits>li+li{border-left:1px solid #badbe6}
.metal-benefits :global(.i){color:#09b63b;width:44px;height:44px;flex:none;stroke-width:1.8;filter:drop-shadow(0 1px 0 #fff)}
.metal-cta{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:25px}
.metal-offer{display:flex;align-items:center;gap:12px;color:#103c36}
.metal-offer>span{font-size:36px;font-weight:850;line-height:1;color:#087e4b;letter-spacing:-.06em}
.metal-offer>span i{font-size:.65em;font-style:normal;color:#a2ca56}
.metal-offer strong{display:block;font-size:13px;line-height:1.6}
.metal-offer small{display:block;font-size:11px;color:#526d5d}
.metal-actions{display:flex;flex-wrap:wrap;gap:12px}
.metal-note{margin:17px 0 0;text-align:center;font-size:9px;letter-spacing:.04em;color:#667d71;line-height:1.7}
@media(min-width:1600px){.metal-heading{min-height:310px}.metal-card-head{min-height:94px}.metal-points{font-size:21px}}
@media(max-width:1100px){.metal-container{width:calc(100% - 40px)}.metal-heading{min-height:225px;margin-bottom:18px}.metal-cards{gap:22px}.metal-card-head{padding:12px 9px;gap:8px;min-height:74px}.metal-icon{width:36px;height:43px;border-radius:10px}.metal-icon :global(.i){width:26px;height:26px}.metal-card-head h2{font-size:17px}.metal-card-body{padding:8px 10px 20px}.metal-points{font-size:14px;gap:12px;padding-top:14px}.metal-check{width:21px;height:21px;margin-top:0}.metal-check :global(.i){width:15px;height:15px}.metal-next{right:-22px;width:20px}.metal-next :global(.i){width:21px}.metal-benefits>li{gap:10px;padding:0 10px;font-size:16px}.metal-benefits :global(.i){width:35px;height:35px}}
@media(max-width:850px){.metal-heading{grid-template-columns:minmax(0,1fr) 26%;min-height:200px}.metal-title-line{font-size:clamp(28px,4.5vw,38px)}.metal-subtitle-line{font-size:20px}.metal-ecosystem-line{font-size:23px}.metal-ai-art{width:132%;margin-left:-22%}.metal-cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 26px}.metal-card-head{padding:15px;min-height:82px;gap:13px}.metal-icon{width:44px;height:49px}.metal-card-head h2{font-size:clamp(21px,3vw,26px)}.metal-card-body{padding:10px 18px 23px}.metal-card-art{max-width:335px}.metal-points{font-size:18px;gap:13px}.metal-check{width:24px;height:24px;margin-top:1px}.metal-check :global(.i){width:17px;height:17px}.metal-next{top:43%;right:-25px;width:23px}.metal-card:nth-child(2) .metal-next{display:none}.metal-benefits{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 0;margin-top:30px;padding:22px 12px}.metal-benefits>li{justify-content:flex-start;padding:0 18px;font-size:18px}.metal-benefits>li:nth-child(3){border-left:0}.metal-cta{gap:18px;align-items:flex-start}.metal-actions{justify-content:flex-end;gap:8px}.metal-actions :global(.home-button){font-size:10px;padding:12px}}
@media(max-width:580px){.metal-hero{padding-top:18px}.metal-container{width:calc(100% - 32px)}.metal-heading{grid-template-columns:1fr;margin-bottom:25px;gap:0}.metal-heading h1{padding:0;z-index:1}.metal-title-line{font-size:clamp(26px,6.5vw,37px);line-height:1.4;margin-bottom:5px;white-space:normal}.metal-subtitle-line{font-size:clamp(19px,4.3vw,25px);line-height:1.5}.metal-subtitle-line .metal-text-gold{display:block}.metal-ecosystem-line{font-size:clamp(21px,4.5vw,27px);margin-top:9px}.metal-ecosystem-line>span{white-space:nowrap}.metal-heading h1:after{width:75px;height:5px;margin-top:18px}.metal-ai-art{width:82%;max-width:325px;margin:-3px 0 -5px auto}.metal-cards{grid-template-columns:1fr;gap:29px}.metal-card{border-radius:20px}.metal-card-head{padding:14px 18px;min-height:82px}.metal-card-head h2{font-size:clamp(23px,6vw,29px)}.metal-icon{width:47px;height:51px}.metal-icon :global(.i){width:31px;height:31px}.metal-card-body{padding:10px 20px 24px}.metal-card-art{max-width:360px}.metal-points{font-size:18px;line-height:1.5}.metal-next,.metal-card:nth-child(2) .metal-next{display:grid;left:calc(50% - 13px);right:auto;top:auto;bottom:-29px;width:26px;height:25px;transform:rotate(90deg)}.metal-benefits{gap:20px 0;padding:20px 6px;border-radius:18px}.metal-benefits>li{gap:8px;font-size:13px;padding:0 9px;letter-spacing:-.03em}.metal-benefits :global(.i){width:29px;height:29px}.metal-cta{flex-direction:column;align-items:stretch;gap:20px}.metal-offer>span{font-size:35px}.metal-offer strong{font-size:12px}.metal-actions{justify-content:flex-start}.metal-actions :global(.home-button){font-size:10px;min-height:43px;gap:6px;padding:10px 12px}.metal-note{font-size:8px;text-align:left}}
@media(prefers-reduced-motion:reduce){.metal-card{transition:none}.metal-card:hover{transform:none}}
</style>
