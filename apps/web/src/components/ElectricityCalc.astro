---
/**
 * Công cụ tính thử hệ số k điện trong bài "Hướng dẫn chi tiết: nhập và xử lý giá thành theo điện".
 * Chỉ minh hoạ; không lưu, không gửi dữ liệu đi đâu. Cách tính theo hộp "Điện chênh lệch so với định mức":
 *   Điện theo định mức của mã = Sản lượng × Định mức điện (kWh/ĐVT)
 *   k = Điện có trong sổ ÷ Tổng điện theo định mức
 *   Sản lượng theo điện (phương án 2) = Sản lượng × k ; Điện xuất cho mã (phương án 1) = Điện định mức × k
 */
const rows = [
  { code: 'T', unit: 'kg', qty: '24.882', rate: '1,053' },
  { code: 'C', unit: 'kg', qty: '1.000', rate: '1,61' },
  { code: '', unit: '', qty: '', rate: '' },
];
const head = ['Mã thành phẩm', 'ĐVT', 'Sản lượng', 'Định mức điện (kWh/ĐVT)', 'Điện theo định mức (kWh)', 'Điện xuất × k (kWh)', 'Sản lượng theo điện', ''];
---
<div class="calc-box" id="calc-dien">
  <div class="calc-meter">
    <label>Điện có trong sổ (kWh) – tồn đầu + nhập − xuất khác<input inputmode="decimal" data-k="have" value="26.492" /></label>
  </div>
  <div class="table-wrap"><table class="article-table calc-table">
    <thead><tr>{head.map((h) => <th>{h}</th>)}</tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td data-label={head[0]}><input data-c="code" value={r.code} aria-label={head[0]} /></td>
          <td data-label={head[1]}><input data-c="unit" value={r.unit} aria-label={head[1]} /></td>
          <td data-label={head[2]}><input data-c="qty" inputmode="decimal" value={r.qty} aria-label={head[2]} /></td>
          <td data-label={head[3]}><input data-c="rate" inputmode="decimal" value={r.rate} aria-label={head[3]} /></td>
          <td data-label={head[4]} data-o="need">–</td>
          <td data-label={head[5]} data-o="alloc">–</td>
          <td data-label={head[6]} data-o="out">–</td>
          <td data-label=""><button type="button" class="calc-del" data-del aria-label="Xoá dòng">Xoá</button></td>
        </tr>
      ))}
    </tbody>
  </table></div>
  <div class="actions"><button type="button" class="btn btn-secondary" data-add>Thêm dòng</button></div>
  <div class="calc-result" aria-live="polite" data-result>Bật JavaScript để xem kết quả tính.</div>
  <p class="caption">Số mặc định là ví dụ của bộ sổ mẫu. Mã thiếu định mức điện bị bỏ qua, giống khung Cân đối AI báo “chưa có định mức điện – bỏ qua”.</p>
</div>
<script is:inline>
(function () {
  var box = document.getElementById('calc-dien');
  if (!box) return;
  var body = box.querySelector('tbody');
  var out = box.querySelector('[data-result]');
  function num(v) {
    var s = String(v || '').replace(/\s/g, '');
    if (!s) return NaN;
    if (s.indexOf(',') >= 0) s = s.replace(/\./g, '').replace(',', '.');
    else if (/^[1-9]\d{0,2}(\.\d{3})+$/.test(s)) s = s.replace(/\./g, '');
    return /^-?\d*\.?\d+$/.test(s) ? Number(s) : NaN;
  }
  function fmt(n, d) { return n.toLocaleString('vi-VN', { maximumFractionDigits: d == null ? 2 : d }); }
  function calc() {
    var have = num(box.querySelector('[data-k="have"]').value);
    var items = Array.prototype.map.call(body.querySelectorAll('tr'), function (tr) {
      var g = function (c) { return tr.querySelector('[data-c="' + c + '"]').value; };
      var o = function (c) { return tr.querySelector('[data-o="' + c + '"]'); };
      var it = { unit: g('unit').trim(), qty: num(g('qty')), rate: num(g('rate')), ok: false, o: o };
      ['need', 'alloc', 'out'].forEach(function (c) { o(c).textContent = '–'; });
      if (!g('code').trim() && isNaN(it.qty) && isNaN(it.rate)) return it;
      if (isNaN(it.qty) || it.qty < 0) { o('need').textContent = 'Nhập sản lượng'; return it; }
      if (isNaN(it.rate) || it.rate <= 0) { o('need').textContent = 'Chưa có định mức điện – bỏ qua'; return it; }
      it.need = it.qty * it.rate; it.ok = true;
      o('need').textContent = fmt(it.need);
      return it;
    });
    var used = items.filter(function (i) { return i.ok; });
    var sum = used.reduce(function (s, i) { return s + i.need; }, 0);
    if (isNaN(have) || have < 0) { out.textContent = 'Nhập số kWh điện có trong sổ.'; return; }
    if (!used.length || sum <= 0) { out.textContent = 'Nhập sản lượng và định mức điện cho ít nhất một mã.'; return; }
    var k = have / sum, diff = have - sum;
    used.forEach(function (i) {
      i.o('alloc').textContent = fmt(i.need * k);
      i.o('out').textContent = fmt(i.qty * k) + (i.unit ? ' ' + i.unit : '');
    });
    var msg = 'Điện theo định mức: ' + fmt(sum) + ' kWh; có trong sổ: ' + fmt(have) + ' kWh; chênh ' + (diff >= 0 ? '+' : '−') + fmt(Math.abs(diff)) + ' kWh; k = ' + fmt(k, 4) + '. ';
    if (Math.abs(diff) < 0.005) msg += 'Điện khớp định mức, không hiện hộp chọn khi Ghi.';
    else if (diff < 0) msg += 'Điện THIẾU: phương án 1 xuất đúng số điện có (cột Điện xuất × k); phương án 2 giảm sản lượng theo điện (cột Sản lượng theo điện).';
    else msg += 'Điện DƯ: phương án 1 xuất hết vào giá thành (× k); phương án 2 tăng sản lượng theo điện; hoặc đưa phần dư vào 1543 / 642.';
    out.textContent = msg;
  }
  box.addEventListener('input', calc);
  box.addEventListener('click', function (e) {
    var t = e.target;
    if (t.closest('[data-add]')) {
      var tr = body.querySelector('tr').cloneNode(true);
      Array.prototype.forEach.call(tr.querySelectorAll('input'), function (i) { i.value = ''; });
      body.appendChild(tr); calc();
    } else if (t.closest('[data-del]')) {
      if (body.querySelectorAll('tr').length > 1) t.closest('tr').remove();
      else Array.prototype.forEach.call(t.closest('tr').querySelectorAll('input'), function (i) { i.value = ''; });
      calc();
    }
  });
  calc();
})();
</script>
