---
import {url} from '../utils/url';
---
<div class="demo-app" id="hddt-demo">
 <header class="app-header"><img src={url('/banner/logo-unesco.webp')} alt="UNESCO" width="170" height="66"/><div><strong>HÓA ĐƠN ĐIỆN TỬ</strong><span>Đồng bộ · Tải hóa đơn · Xuất cho UNESCO XII</span></div><span class="sample-badge">Dữ liệu mẫu</span></header>
 <div class="app-grid">
  <aside class="side-panel"><div class="panel"><h2>1. Bắt đầu demo</h2><p>Thao tác trên bộ hóa đơn minh họa. Không cần đăng nhập.</p><div class="sample-account"><span>Đơn vị minh họa UNESCO</span><strong>MST mẫu: 0000000001</strong></div><button class="primary" id="demo-connect">Vào demo</button><p id="demo-session" role="status">Chưa bắt đầu</p></div><div class="panel"><h2>2. Chọn định dạng</h2><label class="check"><input type="checkbox" checked disabled/> XML mẫu</label><label class="check"><input id="demo-pdf" type="checkbox" checked/> Kèm PDF (mô phỏng)</label><p>Các tệp trong demo không dùng kê khai hay hạch toán.</p></div><div class="help"><strong>Cách thử</strong><p>Vào demo → Đồng bộ mẫu → Chọn hóa đơn → Mô phỏng tải. Bấm số hóa đơn để xem chi tiết.</p><button class="secondary" id="demo-reset">Làm lại demo</button></div></aside>
  <div class="workspace"><div class="panel"><h2>3. Phạm vi đồng bộ</h2><div class="filters"><label>Từ ngày<input type="date" id="demo-from" value="2026-11-01"/></label><label>Đến ngày<input type="date" id="demo-to" value="2026-11-30"/></label><label>Chiều hóa đơn<select id="demo-direction"><option value="all">Mua vào + Bán ra</option><option value="mua">Mua vào</option><option value="ban">Bán ra</option></select></label><button class="primary" id="demo-sync" disabled>Đồng bộ mẫu</button></div></div>
   <div class="metrics"><div><strong id="demo-count">0</strong><span>Hóa đơn trong bảng</span></div><div><strong id="demo-xml">0</strong><span>XML mô phỏng</span></div><div><strong id="demo-pdf-count">0</strong><span>PDF mô phỏng</span></div><div><strong id="demo-missing">0</strong><span>XML còn thiếu</span></div></div>
   <p class="notice" id="demo-notice" role="status" aria-live="polite">Bấm “Vào demo” để bắt đầu. Toàn bộ hóa đơn là dữ liệu mẫu.</p>
   <div class="searchbar"><label class="search-label">Tìm hóa đơn<input type="search" id="demo-search" placeholder="Số HĐ, tên đối tác, MST…"/></label><label>Trạng thái tệp<select id="demo-file-filter"><option value="all">Tất cả tệp</option><option value="missing">Thiếu XML</option><option value="done">Đã mô phỏng tải XML</option></select></label></div>
   <div class="table-scroll" tabindex="0" aria-label="Bảng hóa đơn mẫu, có thể cuộn ngang"><table><thead><tr><th><input type="checkbox" id="demo-select-all" aria-label="Chọn tất cả hóa đơn đang hiển thị"/></th><th>Ngày lập</th><th>Chiều</th><th>Số HĐ</th><th>Đối tác</th><th class="number">Thanh toán</th><th>XML</th><th>PDF</th></tr></thead><tbody id="demo-rows"><tr><td colspan="8" class="empty">Chưa có danh sách. Vào demo rồi bấm Đồng bộ mẫu.</td></tr></tbody></table></div>
   <div class="table-actions"><button class="primary" id="demo-download" disabled>Mô phỏng tải XML/PDF</button><button class="secondary" id="demo-export" disabled>Xuất CSV mẫu</button><span id="demo-selection">Chưa chọn dòng</span></div><p class="scope-note">Có chọn dòng: xử lý các dòng đã chọn. Chưa chọn: xử lý toàn bộ bảng đang hiển thị. Bộ lọc chỉ áp dụng trong dữ liệu mẫu.</p>
  </div>
 </div>
 <footer class="app-footer"><strong>CÔNG TY TNHH PHẦN MỀM UNESCO</strong><span>www.unescosoft.com · unesco.corp@gmail.com · 028 3755 5755</span></footer>
</div>
<dialog id="demo-detail"><div class="detail-head"><h2>Chi tiết hóa đơn mẫu</h2><button id="demo-close-detail" aria-label="Đóng chi tiết">Đóng</button></div><dl id="demo-detail-fields"></dl><p>Chỉ để trải nghiệm giao diện; không phải hóa đơn thật.</p></dialog>
<script>
 type Invoice={id:number,date:string,direction:string,partner:string,total:number,xml:boolean,pdf:boolean};
 const app=document.querySelector<HTMLElement>('#hddt-demo')!;
 const el=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T;
 const button=(id:string)=>el<HTMLButtonElement>(id);
 const input=(id:string)=>el<HTMLInputElement>(id);
 const select=(id:string)=>el<HTMLSelectElement>(id);
 const money=(n:number)=>new Intl.NumberFormat('vi-VN').format(n)+' đ';
 const fold=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[đĐ]/g,'d').toLowerCase();
 const seed=()=>[['Minh An',12500000,'mua'],['An Phát',8640000,'mua'],['Hoàng Gia',2160000,'mua'],['Đại Việt',31500000,'mua'],['Bình Minh',6600000,'ban'],['Tân Phú',4800000,'ban']].map((v,i)=>({id:125+i,date:`2026-11-${String(12+i).padStart(2,'0')}`,direction:String(v[2]),partner:'Công ty mẫu '+v[0],total:Number(v[1]),xml:false,pdf:false}));
 let rows:Invoice[]=[],connected=false;const selected=new Set<number>();
 function visible(){const term=fold(input('demo-search').value),filter=select('demo-file-filter').value;return rows.filter(r=>(!term||fold(`${r.id} ${r.partner} 0000000002 C26TMA`).includes(term))&&(filter==='all'||(filter==='missing'?!r.xml:r.xml)));}
 function notice(text:string){el('demo-notice').textContent=text;}
 function scope(){const shown=visible();return selected.size?shown.filter(r=>selected.has(r.id)):shown;}
 function render(){
  const shown=visible();for(const id of selected)if(!shown.some(r=>r.id===id))selected.delete(id);
  const tbody=el('demo-rows');tbody.replaceChildren();
  for(const r of shown){const tr=document.createElement('tr');const td=document.createElement('td');const check=document.createElement('input');check.type='checkbox';check.checked=selected.has(r.id);check.setAttribute('aria-label','Chọn hóa đơn '+r.id);check.addEventListener('change',()=>{check.checked?selected.add(r.id):selected.delete(r.id);render();});td.append(check);tr.append(td);
   for(const value of [r.date,r.direction==='mua'?'Mua':'Bán',String(r.id),r.partner,money(r.total),r.xml?'Đã mô phỏng':'Chưa có',r.pdf?'Đã mô phỏng':'Chưa có']){const cell=document.createElement('td');if(value===String(r.id)){const b=document.createElement('button');b.className='invoice-link';b.textContent=value;b.addEventListener('click',()=>details(r));cell.append(b);}else cell.textContent=value;if(value===money(r.total))cell.className='number';if(value==='Đã mô phỏng')cell.className='done';tr.append(cell);}tbody.append(tr);}
  if(!shown.length){const tr=document.createElement('tr'),td=document.createElement('td');td.colSpan=8;td.className='empty';td.textContent=connected?'Không có hóa đơn phù hợp. Bấm Đồng bộ mẫu hoặc đổi bộ lọc.':'Chưa có danh sách. Vào demo rồi bấm Đồng bộ mẫu.';tr.append(td);tbody.append(tr);}
  el('demo-count').textContent=String(shown.length);el('demo-xml').textContent=String(shown.filter(r=>r.xml).length);el('demo-pdf-count').textContent=String(shown.filter(r=>r.pdf).length);el('demo-missing').textContent=String(shown.filter(r=>!r.xml).length);
  input('demo-select-all').checked=shown.length>0&&selected.size===shown.length;input('demo-select-all').indeterminate=selected.size>0&&selected.size<shown.length;
  button('demo-download').disabled=!shown.length;button('demo-export').disabled=!shown.length;el('demo-selection').textContent=selected.size?`Đã chọn ${selected.size} hóa đơn`:'Chưa chọn dòng — áp dụng cả bảng';
 }
 button('demo-connect').addEventListener('click',()=>{connected=true;button('demo-sync').disabled=false;button('demo-connect').disabled=true;el('demo-session').textContent='Đang dùng tài khoản mẫu';notice('Demo đã sẵn sàng. Chọn kỳ và bấm “Đồng bộ mẫu”.');});
 button('demo-sync').addEventListener('click',()=>{const from=input('demo-from').value,to=input('demo-to').value,direction=select('demo-direction').value;if(!from||!to||from>to){notice('Chọn kỳ hợp lệ: Từ ngày không được sau Đến ngày.');return;}rows=seed().filter(r=>r.date>=from&&r.date<=to&&(direction==='all'||r.direction===direction));selected.clear();render();notice(`Đã đồng bộ ${rows.length} hóa đơn mẫu. Chọn dòng hoặc thử tìm kiếm không dấu.`);});
 input('demo-search').addEventListener('input',render);select('demo-file-filter').addEventListener('change',render);
 input('demo-select-all').addEventListener('change',()=>{selected.clear();if(input('demo-select-all').checked)visible().forEach(r=>selected.add(r.id));render();});
 button('demo-download').addEventListener('click',()=>{const targets=scope(),pdf=input('demo-pdf').checked;for(const r of targets){r.xml=true;if(pdf)r.pdf=true;}notice(`Đã mô phỏng tải ${targets.length} hóa đơn${pdf?' XML và PDF':' XML'}. Không kết nối cổng thuế hoặc tải hóa đơn thật.`);render();});
 button('demo-export').addEventListener('click',()=>{const targets=scope();const text='\uFEFF'+[['DU LIEU MAU - KHONG DUNG HACH TOAN'],['Ngay lap','So HD','Doi tac','Thanh toan','XML mo phong','PDF mo phong'],...targets.map(r=>[r.date,r.id,r.partner,r.total,r.xml?'Co':'Chua',r.pdf?'Co':'Chua'])].map(line=>line.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(',')).join('\r\n');const href=URL.createObjectURL(new Blob([text],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=href;a.download='UNESCO_HDDT_DU_LIEU_MAU.csv';a.click();setTimeout(()=>URL.revokeObjectURL(href),1000);notice(`Đã xuất ${targets.length} dòng CSV mẫu.`);});
 button('demo-reset').addEventListener('click',()=>{rows=[];selected.clear();connected=false;button('demo-connect').disabled=false;button('demo-sync').disabled=true;input('demo-search').value='';select('demo-file-filter').value='all';select('demo-direction').value='all';input('demo-from').value='2026-11-01';input('demo-to').value='2026-11-30';input('demo-pdf').checked=true;el('demo-session').textContent='Chưa bắt đầu';render();notice('Đã làm lại demo. Bấm “Vào demo” để bắt đầu.');});
 function details(r:Invoice){const list=el('demo-detail-fields');list.replaceChildren();for(const [name,value] of [['Số hóa đơn',r.id],['Ngày lập',r.date],['Đối tác',r.partner],['Tổng thanh toán',money(r.total)],['Ký hiệu mẫu','C26TMA']]){const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=String(name);dd.textContent=String(value);list.append(dt,dd);}el<HTMLDialogElement>('demo-detail').showModal();}
 button('demo-close-detail').addEventListener('click',()=>el<HTMLDialogElement>('demo-detail').close());
 if(app)render();
</script>
<style>
.demo-app{border:1px solid #bedacb;border-radius:16px;overflow:hidden;background:white;box-shadow:0 15px 45px #184c2e0d;font-size:.9rem;color:#244537}.app-header{display:flex;align-items:center;gap:1.5rem;padding:1.3rem 1.5rem;border-bottom:1px solid #d3e5dc}.app-header img{object-fit:contain;width:170px;height:66px}.app-header strong{display:block;font-size:1.4rem;color:#174934}.app-header div span{color:#5a7167;font-size:.85rem}.sample-badge{margin-left:auto;border:1px solid #acd9bf;background:#f2fbf5;border-radius:20px;padding:.4rem .8rem;white-space:nowrap;color:#176b43}.app-grid{display:grid;grid-template-columns:250px minmax(0,1fr);gap:1.2rem;padding:1.2rem}.side-panel{display:flex;flex-direction:column;gap:1rem}.panel{border:1px solid #c6ded0;border-radius:12px;padding:1rem;background:#fff}.panel h2{font-size:1rem;color:#116840;margin:0 0 1rem}.panel p,.help p{font-size:.875rem;color:#5b7365;line-height:1.7}.sample-account{display:flex;flex-direction:column;gap:.5rem;padding:1rem 0;font-size:.85rem}.demo-app button{cursor:pointer;font:inherit;border-radius:7px;min-height:42px;padding:.65rem .85rem;line-height:1.4}.primary{background:#0a7a4d;color:#fff;border:1px solid #0a7a4d;font-weight:700}.primary:hover{background:#075d3a}.secondary{background:#f6faf7;color:#246044;border:1px solid #bdd8c8}.demo-app button:disabled{opacity:.5;cursor:default}.side-panel button{width:100%}.check{display:flex;gap:.6rem;align-items:center;margin:1rem 0}.demo-app input[type=checkbox]{width:18px;height:18px;accent-color:#0b8654;flex:none}.help{padding:1rem;border-radius:12px;background:#f5faf7}.filters{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;align-items:end}.filters button{grid-column:1/-1}.demo-app label:not(.check){display:flex;flex-direction:column;gap:.4rem;font-size:.85rem;color:#456453}.demo-app input:not([type=checkbox]),.demo-app select{font:inherit;min-height:44px;border:1px solid #b5cec0;border-radius:7px;padding:.5rem .6rem;background:#fff;color:#244537;width:100%;min-width:0}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem;margin:1rem 0}.metrics div{background:#f4faf6;border:1px solid #c6e1d1;border-radius:10px;padding:.8rem}.metrics strong{display:block;color:#087d4c;font-size:1.7rem}.metrics span{font-size:.8rem;color:#4d6a58}.notice{background:#edf8f1;border:1px solid #c6e3d1;border-radius:8px;padding:.8rem 1rem;color:#2d6245;line-height:1.6;min-height:3rem}.searchbar{display:flex;gap:1rem;align-items:end;margin:1rem 0}.search-label{flex:1}.searchbar label:last-child{width:200px}.table-scroll{overflow-x:auto;border:1px solid #c7ddd0;border-radius:8px;min-height:230px}.demo-app table{width:100%;border-collapse:collapse;font-size:.85rem;white-space:nowrap}.demo-app th{background:#edf6f0;text-align:left;color:#2b5740;font-weight:700}.demo-app td,.demo-app th{padding:.75rem .65rem;border-bottom:1px solid #e0ece5}.demo-app tr:nth-child(even){background:#f8fbf9}.demo-app :global(.number){text-align:right}.demo-app :global(.done){color:#087a47;font-weight:600}.demo-app :global(.empty){padding:2.5rem 1rem;text-align:center;white-space:normal;color:#5b7365}.demo-app :global(.invoice-link){min-height:28px;padding:0;border:0;background:transparent;color:#087746;text-decoration:underline}.table-actions{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap;margin-top:1rem}.table-actions span{font-size:.8rem;color:#586c61}.scope-note{color:#617568;font-size:.8rem;line-height:1.6}.app-footer{display:flex;gap:1rem;justify-content:space-between;padding:1rem 1.5rem;border-top:1px solid #ccdfd3;font-size:.8rem;color:#42694f}.app-footer strong{color:#087247}dialog{border:1px solid #b8d6c5;border-radius:16px;padding:1.5rem;width:min(92vw,540px);color:#264834;background:white}dialog::backdrop{background:#163c2a66}.detail-head{display:flex;justify-content:space-between;gap:1rem}.detail-head h2{font-size:1.25rem;margin:0}.detail-head button{border:1px solid #b2c9bb;background:#f5faf7;border-radius:6px;padding:.4rem .8rem;cursor:pointer}dialog :global(dt){font-size:.85rem;color:#62796a;margin-top:1rem}dialog :global(dd){margin:.3rem 0;font-weight:600}dialog p{font-size:.9rem;color:#586f60}.demo-app :is(button,input,select):focus-visible{outline:3px solid #53b58a;outline-offset:2px}@media(max-width:1050px){.app-grid{grid-template-columns:210px minmax(0,1fr)}.app-header strong{font-size:1.2rem}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.app-grid{grid-template-columns:1fr;padding:.8rem}.side-panel{display:grid;grid-template-columns:1fr 1fr}.help{grid-column:1/-1}.app-header{gap:.8rem;padding:1rem;flex-wrap:wrap}.app-header img{width:130px;height:50px}.app-header div{flex:1;min-width:150px}.sample-badge{margin-left:0}.app-footer{flex-direction:column;gap:.4rem}.searchbar{align-items:stretch;flex-direction:column}.searchbar label:last-child{width:auto}}@media(max-width:440px){.side-panel{grid-template-columns:1fr}.filters{grid-template-columns:1fr 1fr}.filters label:nth-child(3){grid-column:1/-1}.app-header strong{font-size:1.1rem}.table-actions button{width:100%}}
.demo-app :global(td){padding:.75rem .65rem;border-bottom:1px solid #e0ece5}.demo-app :global(tbody tr:nth-child(even)){background:#f8fbf9}.demo-app table{min-width:760px}.workspace,.side-panel,.panel{min-width:0}@media(max-width:760px){.app-grid{grid-template-columns:minmax(0,1fr)}}
</style>
