---
import { url } from '../../utils/url';
import ContentLayout from '../../layouts/ContentLayout.astro';
import Icon from '../../components/Icon.astro';
import { aiGroups, aiMap, aiRules, aiFeatureCount, aiNewCount } from '../../data/ai-catalog';
import { whatsNew } from '../../data/whatsnew';
import { latest as release } from '../../data/advantages';
---
<ContentLayout title={`Tổng hợp ${aiFeatureCount} tính năng AI trong UNESCO AI`} description={`AI nằm ở đâu trong phần mềm kế toán UNESCO, mỗi tính năng làm gì, mở từ menu / nút nào và ranh giới AI không bao giờ vượt – ${aiFeatureCount} tính năng trong ${aiGroups.length} nhóm.`} eyebrow={`Tài liệu tổng hợp · bản ${release.code}`} display={`${aiFeatureCount} TÍNH NĂNG |AI`} subtitle="AI nằm ở đâu, mỗi tính năng làm gì, mở từ menu / nút nào" pills={[`${aiFeatureCount} tính năng trong ${aiGroups.length} nhóm`, `${aiNewCount} tính năng mới GĐ159 – GĐ168`, '1 nguyên tắc: AI chuẩn bị, người duyệt']}>

<section class="section"><div class="container">
  <div class="section-head"><div><span class="eyebrow">Bản đồ AI</span><h2>AI nằm ngay trong các màn hình kế toán đang dùng</h2></div><p>AI không phải phần mềm riêng. Bốn nơi làm việc chính:</p></div>
  <div class="map4">{aiMap.map((m, i) => <div class={`card ${['top-g', 'top-b', 'top-t', 'top-y'][i]}`}><h3><span class={`ic sm ${['g', 'b', 't', 'y'][i]}`}><Icon name={m.icon} /></span>{m.t}</h3><ul>{m.items.map((x) => <li>{x}</li>)}</ul></div>)}</div>
  <h3 style="margin-top:34px">Ba câu chốt</h3>
  <div class="rules3">{aiRules.map((r, i) => <div><span>{i + 1}</span>{r}</div>)}</div>
</div></section>

<section class="section surface-soft"><div class="container">
  <nav class="cat-nav" aria-label="Nhóm tính năng">{aiGroups.map((g) => <a href={`#${g.id}`}><span>{g.items.length}</span>{g.t}</a>)}</nav>
  <p class="caption">Các mục mới của menu Dữ liệu và Hệ thống hiện không dấu trên máy, ví dụ “Lai theo mat hang / khach hang…”.</p>
  {aiGroups.map((g) => (
    <div class="cat" id={g.id}>
      <div class="cat-head"><span class="n">{g.n}</span><span class="ic sm g"><Icon name={g.icon} /></span><h2>{g.t}</h2></div>
      <p class="cat-where"><b>Mở ở đâu:</b> {g.where}</p>
      <div class="table-wrap" style="border:0"><table class="feat-table"><thead><tr><th>Tính năng</th><th>Mở ở đâu</th><th>AI làm gì</th></tr></thead><tbody>
        {g.items.map((f) => <tr><td>{f.t}{f.isNew && <em class="new">Mới</em>}</td><td>{f.where}</td><td>{f.d}</td></tr>)}
      </tbody></table></div>
    </div>
  ))}
</div></section>

<section class="section" id="co-gi-moi"><div class="container">
  <div class="section-head"><div><span class="eyebrow">Phụ lục</span><h2>Có gì mới theo từng gói</h2></div><p>Trên phần mềm: F1 rồi gõ “co gi moi gd…” để xem chi tiết từng gói.</p></div>
  <ul class="wn-list">{whatsNew.slice(0, 12).map((w) => <li><b><span class="code">{w.code}</span>{w.t}</b><p>{w.d}</p></li>)}</ul>
  <div class="actions" style="margin-top:10px"><a class="btn btn-secondary" href={url('/release-notes/')}>Toàn bộ lịch sử cập nhật</a><a class="btn btn-primary" href={url('/tinh-nang-uu-viet/')}>16 điểm ưu việt</a></div>
</div></section>
</ContentLayout>
