---
import { url } from '../../utils/url';
import ContentLayout from '../../layouts/ContentLayout.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site.config';
import { contact } from '../../data/contact';
import { copyrightCerts, productHistory } from '../../data/copyright';
const co = site.company;
const old = site.formerCompany;
const cr = site.copyright;
const og = site.origin;
const nowRows = [
  ['Tên công ty', co.legalName],
  ['Tên tiếng nước ngoài', co.legalNameEn],
  ['Loại hình', 'Công ty trách nhiệm hữu hạn một thành viên'],
  ['Mã số doanh nghiệp / MST', co.taxCode],
  ['Đăng ký lần đầu', co.firstRegistered],
  ['Đăng ký thay đổi', co.latestChange],
  ['Trụ sở chính', co.registeredAddress],
  ['Nơi cấp', co.registrationAuthority],
];
const oldRows = [
  ['Tên công ty', old.legalName],
  ['Tên tiếng nước ngoài', old.legalNameEn],
  ['Số đăng ký kinh doanh', `${old.businessRegistration} – ngày ${old.registered}`],
  ['Địa chỉ', old.address],
  ['Giám đốc', old.director],
  ['Vai trò', 'Chủ sở hữu ghi trên 4 giấy chứng nhận đăng ký quyền tác giả 2011 – 2012'],
];
---
<ContentLayout title="Bản quyền & pháp lý UNESCO" description={`Phần mềm kế toán UNESCO ra đời năm 1999. Bản quyền: 4 giấy chứng nhận đăng ký quyền tác giả 2011 – 2012, tác giả ${cr.author}. Pháp nhân trước đây là ${old.legalName}, nay là ${co.legalName} (MST ${co.taxCode}).`} eyebrow="Bản quyền tác giả – pháp nhân – lịch sử sản phẩm" display="BẢN QUYỀN & |PHÁP LÝ" tone="ng" subtitle={`Tác giả phần mềm: ${cr.author} · Pháp nhân hiện nay: ${co.legalName}`} pills={['Ra đời năm 1999', '4 giấy chứng nhận quyền tác giả', `Tác giả: ${cr.author}`]}>

<section class="section"><div class="container">
  <div class="sec-c"><span class="eyebrow">Pháp nhân & tác giả</span><h2>Từ {og.founded} – <span class="tg">kế thừa và phát triển liên tục</span></h2><p>Phần mềm kế toán UNESCO ra đời năm {og.founded} tại {og.name}, do {og.founder} thành lập. Trung tâm giải thể năm {og.dissolved}; các thành viên kế thừa và phát triển qua {old.legalName} – Giám đốc và tác giả là {cr.author}. Nay pháp nhân chuyển sang {co.legalName}; tác giả phần mềm vẫn là {cr.author}.</p></div>
  <div class="entity-flow e3">
    <div class="entity root">
      <span class="when">{og.founded} – {og.dissolved}</span>
      <h3>{og.name}</h3>
      <p class="en">{og.short} Software Center</p>
      <ul><li>Do <b>{og.founder}</b> thành lập năm {og.founded}</li><li>Ra đời Chương trình kế toán UNESCO</li><li>Giải thể năm {og.dissolved}</li></ul>
    </div>
    <div class="entity-arrow" aria-hidden="true"><Icon name="arrow-right" /></div>
    <div class="entity was">
      <span class="when">Từ 2011</span>
      <h3>{old.legalName}</h3>
      <p class="en">{old.legalNameEn}</p>
      <ul><li>Số ĐKKD <b>{old.businessRegistration}</b> – ngày {old.registered}</li><li>Giám đốc: <b>{old.director}</b></li><li>Các thành viên kế thừa và phát triển; chủ sở hữu ghi trên 4 giấy chứng nhận quyền tác giả</li></ul>
    </div>
    <div class="entity-arrow" aria-hidden="true"><Icon name="arrow-right" /></div>
    <div class="entity now">
      <span class="when">Hiện nay</span>
      <h3>{co.legalName}</h3>
      <p class="en">{co.legalNameEn}</p>
      <ul><li>Mã số doanh nghiệp <b>{co.taxCode}</b></li><li>{co.latestChange}</li><li>Phát triển và cung cấp phần mềm kế toán UNESCO AI</li></ul>
    </div>
  </div>
  <div class="author-bar"><span class="ic"><Icon name="user-check" /></span><div><b>Tác giả phần mềm: {cr.author}</b><span>Tác giả của cả 4 phần mềm đã đăng ký quyền tác giả – không thay đổi khi đổi pháp nhân.</span></div></div>
</div></section>

<section class="section surface" id="chung-nhan"><div class="container">
  <div class="section-head"><div><span class="eyebrow">Chứng nhận</span><h2>Giấy chứng nhận đăng ký quyền tác giả</h2></div><p>Do Cục Bản quyền tác giả – Bộ Văn hoá, Thể thao và Du lịch cấp. Loại hình: chương trình máy tính. Bấm vào ảnh để xem cỡ lớn.</p></div>
  <div class="qtg-list">
    {copyrightCerts.map((c) => (
      <article class={`qtg c-${c.c}`}>
        <a class="qtg-img" href={url(`/chung-nhan/${c.img}-lon.webp`)} target="_blank" rel="noopener"><img src={url(`/chung-nhan/${c.img}.webp`)} alt={`Giấy chứng nhận đăng ký quyền tác giả số ${c.no} – ${c.work}`} width="1200" height="575" loading="lazy" decoding="async" /></a>
        <div class="qtg-info">
          <span class="qtg-no"><Icon name="award" />Số {c.no}</span>
          <h3>{c.work}</h3>
          <dl>
            <dt>Ngày cấp</dt><dd>{c.date}</dd>
            <dt>Sản phẩm</dt><dd>{c.product}</dd>
            <dt>Tác giả</dt><dd>{cr.author}</dd>
            <dt>Chủ sở hữu</dt><dd>{old.legalName} (ĐKKD {old.businessRegistration})</dd>
          </dl>
        </div>
      </article>
    ))}
  </div>
  <p class="caption" style="margin-top:16px">Ảnh đã che số CMND, địa chỉ cá nhân của tác giả và thông tin khách hàng trên ảnh màn hình. Bao bì và đĩa cài đặt giai đoạn 2011 – 2012 in thông tin liên hệ cũ; liên hệ hiện nay: {contact.email} · {contact.websiteLabel}.</p>
</div></section>

<section class="section"><div class="container">
  <div class="section-head"><div><span class="eyebrow">Thông tin doanh nghiệp</span><h2>Pháp nhân hiện nay và trước đây</h2></div><p>Theo giấy chứng nhận đăng ký doanh nghiệp và giấy chứng nhận quyền tác giả.</p></div>
  <div class="grid grid-2" style="align-items:start">
    <div class="table-wrap" style="border:0"><table class="src-table"><thead><tr><th colspan="2">Hiện nay</th></tr></thead><tbody>{nowRows.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td></tr>)}</tbody></table></div>
    <div class="table-wrap" style="border:0"><table class="src-table was"><thead><tr><th colspan="2">Trước đây</th></tr></thead><tbody>{oldRows.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td></tr>)}</tbody></table></div>
  </div>
</div></section>

<section class="section surface-soft" id="lich-su"><div class="container">
  <div class="sec-c"><span class="eyebrow">Lịch sử sản phẩm</span><h2>Phần mềm kế toán UNESCO <span class="tg">từ 1999</span></h2><p>Ảnh màn hình lưu trữ; thông tin khách hàng và liên hệ cũ trên ảnh đã được làm mờ.</p></div>
  <ol class="hist">
    {productHistory.map((h) => (
      <li class={h.img ? '' : 'noimg'}>
        <div class="hist-y"><span class="ic sm g"><Icon name={h.icon} /></span><b>{h.y}</b></div>
        <div class="hist-c"><span class="hist-yr">{h.y}</span><h3>{h.t}</h3><p>{h.d}</p></div>
        {h.img && <a class="hist-img" href={url(h.img)} target="_blank" rel="noopener"><img src={url(h.img)} alt={h.alt} loading="lazy" decoding="async" /></a>}
      </li>
    ))}
  </ol>
  <div class="callout" style="margin-top:30px"><span class="ic"><Icon name="history" /></span><div><h3>Xem lịch sử cập nhật UNESCO AI</h3><p>Từng gói cập nhật và 6 nhóm tính năng mới nhất.</p></div><a class="btn btn-secondary" style="margin-left:auto" href={url('/release-notes/')}>Có gì mới</a><a class="btn btn-primary" href={url('/phan-tich-tinh-nang/')}>Tính năng mới 2026</a></div>
</div></section>
</ContentLayout>
