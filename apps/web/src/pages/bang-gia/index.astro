---
import { url } from '../../utils/url';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { contact, telHref, zaloHref } from '../../data/contact';
const rows: [string, boolean, boolean][] = [
  ['9 phân hệ kế toán (tổng hợp, vật tư, công nợ, TSCĐ, CCDC, giá thành, lương, BHXH, báo cáo)', true, true],
  ['Báo cáo tài chính, sổ kế toán theo TT133 và TT99; báo cáo thuế GTGT, TNDN, TNCN', true, true],
  ['Tải hoá đơn điện tử về phần mềm; xuất XML HTKK', true, true],
  ['Màn hình AI: Tự động xử lý, Danh sách hoá đơn (tạo mã, định khoản, lập chứng từ hàng loạt)', false, true],
  ['Sổ phụ ngân hàng: AI đọc sao kê Excel/CSV/PDF, ảnh scan; công nợ kèm mã VietQR', false, true],
  ['Tờ khai hải quan nhập khẩu; Import bảng kê hoá đơn Excel', false, true],
  ['Bảng lương & chứng từ khác; Kết chuyển cuối kỳ; Cổng dịch vụ công', false, true],
  ['Báo cáo & nhật ký: 01/GTGT, BCTC, 03/TNDN, kiểm tra khoá sổ', false, true],
  ['Giá thành: Cân đối AI, định mức tự động, giá thành theo đối tượng', false, true],
  ['Trợ lý AI hướng dẫn ngay trên màn hình', false, true],
];
---
<ContentLayout title="Bảng giá UNESCO AI" description="Chọn đúng phạm vi trước khi nhận báo giá: kế toán nền tảng, UNESCO AI với mã kích hoạt AI theo thời hạn và số công ty, cùng dịch vụ triển khai." eyebrow="Gói sản phẩm">
<section class="section"><div class="container"><div class="grid grid-3 pricing">
  <div class="card price-card"><span class="tag">KẾ TOÁN</span><h3 style="margin-top:18px">Kế toán nền tảng</h3><p class="muted">Dành cho doanh nghiệp cần đủ nghiệp vụ kế toán, sổ sách và báo cáo thuế.</p><div class="price">Liên hệ báo giá</div><ul class="checks"><li>9 phân hệ kế toán</li><li>Báo cáo TT133 · TT99</li><li>Tải hoá đơn điện tử</li><li>Xuất XML HTKK</li></ul><a class="btn btn-secondary" href={url('/lien-he/')} style="margin-top:22px">YÊU CẦU BÁO GIÁ</a></div>
  <div class="card price-card featured"><span class="tag">ĐỀ XUẤT</span><h3 style="margin-top:18px">UNESCO AI</h3><p class="muted">Kế toán nền tảng cộng màn hình AI 8 thẻ cho đơn vị có nhiều hoá đơn, sổ phụ, giá thành.</p><div class="price">Liên hệ báo giá</div><ul class="checks"><li>Toàn bộ kế toán nền tảng</li><li>Tải & tự động xử lý hoá đơn</li><li>Sổ phụ ngân hàng, VietQR</li><li>Tờ khai HQ, bảng lương, kết chuyển</li><li>Giá thành có Cân đối AI</li></ul><a class="btn btn-primary" href={url('/lien-he/#demo')} style="margin-top:22px">ĐĂNG KÝ DEMO</a></div>
  <div class="card price-card"><span class="tag tag-blue">DỊCH VỤ</span><h3 style="margin-top:18px">Triển khai & đào tạo</h3><p class="muted">Cài đặt, chuyển dữ liệu và hướng dẫn để bộ phận kế toán dùng được ngay.</p><div class="price">Theo phạm vi</div><ul class="checks"><li>Cài đặt phần mềm, bộ font</li><li>Nhập/chuyển số dư đầu kỳ</li><li>Quy tắc hạch toán, định mức</li><li>Hướng dẫn theo nghiệp vụ</li></ul><a class="btn btn-secondary" href={url('/lien-he/')} style="margin-top:22px">NHẬN TƯ VẤN</a></div>
</div></div></section>

<section class="section surface-soft"><div class="container split"><div><span class="eyebrow">Mã kích hoạt AI</span><h2>Một mã cho mọi tính năng AI</h2><p class="lead">Gói AI được cấp bằng mã kích hoạt. Phần kế toán dùng bình thường khi chưa có mã.</p></div><div class="card"><ul class="checks"><li><b>Thời hạn:</b> 1, 3, 6 tháng, 1, 2 năm hoặc vĩnh viễn</li><li><b>Số công ty:</b> tính theo mã số thuế của bộ sổ</li><li><b>Số trang:</b> mỗi trang ảnh hoặc PDF scan chuyển sang Excel trừ vào số trang của mã; tệp Excel và CSV không tính; nạp thêm thì số trang cộng dồn</li><li><b>Gia hạn:</b> còn 7 ngày phần mềm nhắc gia hạn</li></ul></div></div></section>

<section class="section surface"><div class="container"><div class="section-head"><div><span class="eyebrow">So sánh</span><h2>Kế toán nền tảng và UNESCO AI</h2></div><p>AI làm việc trên chính bộ sổ UNESCO, nên doanh nghiệp đang dùng UNESCO XI có thể kích hoạt AI khi cần.</p></div>
  <div class="table-wrap"><table class="compare"><thead><tr><th>Chức năng</th><th class="c">Nền tảng</th><th class="c">UNESCO AI</th></tr></thead><tbody>{rows.map((r) => <tr><td>{r[0]}</td><td class={r[1] ? 'y' : 'n'}>{r[1] ? '✓' : '—'}</td><td class={r[2] ? 'y' : 'n'}>{r[2] ? '✓' : '—'}</td></tr>)}</tbody></table></div>
</div></section>

<section class="section surface-soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Trước khi báo giá</span><h2>4 thông tin giúp xác định đúng gói</h2></div><p>Chuẩn bị trước các thông tin này, bộ phận kinh doanh sẽ báo giá nhanh và chính xác hơn.</p></div><div class="grid grid-4"><div class="card"><h3>Loại hình</h3><p class="muted">Thương mại, dịch vụ, sản xuất, xây dựng, hộ kinh doanh hoặc kế toán dịch vụ.</p></div><div class="card"><h3>Số công ty</h3><p class="muted">Số bộ sổ (mã số thuế) cần quản lý và số máy sử dụng.</p></div><div class="card"><h3>Khối lượng AI</h3><p class="muted">Số hoá đơn mỗi tháng, ngân hàng đang dùng, sao kê dạng file hay ảnh scan.</p></div><div class="card"><h3>Dữ liệu hiện có</h3><p class="muted">Phần mềm đang dùng và nhu cầu chuyển số dư đầu kỳ.</p></div></div></div></section>

<section class="section"><div class="container"><div class="quote-band"><div><h2>Liên hệ để nhận báo giá phù hợp</h2><p>Kinh doanh: {contact.sales.mobile} · {contact.sales.phone} ({contact.sales.ext}) · Email: {contact.email}</p></div><div class="actions"><a class="btn btn-primary" href={telHref(contact.sales.mobile)}>GỌI {contact.sales.mobile}</a><a class="btn btn-secondary" href={zaloHref} target="_blank" rel="noopener">CHAT ZALO</a></div></div></div></section>
</ContentLayout>
