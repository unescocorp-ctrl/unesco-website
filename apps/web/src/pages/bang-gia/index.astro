---
import { softwareSchema } from '../../data/seo';
import { hddtSoftwareSchema } from '../../data/hddt';
import ContentLayout from '../../layouts/ContentLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductVideoModal from '../../components/ProductVideoModal.astro';
import ScreenViewer from '../../components/ScreenViewer.astro';
import { contact, telHref, zaloHref } from '../../data/contact';
import { products, families, productsIn } from '../../data/products';
/** Giá lấy từ data/products.ts (bảng giá 17/11/2026). MST = mã số thuế (mỗi công ty / bộ sổ một MST). */
const rows: [string, boolean, boolean][] = [
  ['9 phân hệ kế toán (tổng hợp, vật tư, công nợ, TSCĐ, CCDC, giá thành, lương, BHXH, báo cáo)', true, true],
  ['Báo cáo tài chính, sổ kế toán theo Thông tư 133 và Thông tư 99; báo cáo thuế GTGT, TNDN, TNCN', true, true],
  ['Tải hoá đơn điện tử về phần mềm; xuất XML HTKK', true, true],
  ['Màn hình AI: Tự động xử lý, Danh sách hoá đơn (tạo mã, định khoản, lập chứng từ hàng loạt)', false, true],
  ['Sổ phụ ngân hàng: AI đọc sao kê Excel/CSV/PDF, ảnh chụp; công nợ kèm mã VietQR', false, true],
  ['Tờ khai hải quan nhập khẩu; nhập hoá đơn từ bảng kê Excel', false, true],
  ['Bảng lương & chứng từ khác; Kết chuyển cuối kỳ; Cổng dịch vụ công', false, true],
  ['Báo cáo & nhật ký: 01/GTGT, BCTC, 03/TNDN, kiểm tra khoá sổ', false, true],
  ['Giá thành: Cân đối AI, định mức tự động, giá thành theo đối tượng', false, true],
  ['Trợ lý AI hướng dẫn ngay trên màn hình', false, true],
];
---
<ContentLayout title="Bảng giá sản phẩm UNESCO" schema={[softwareSchema, hddtSoftwareSchema]} description="Bảng giá UNESCO HĐĐT miễn phí và các sản phẩm UNESCO: UNESCO XII AI 10.000.000 đ / MST tặng kèm ERP_UNESCO, UNESCO_TAX_Online, UNESCO SalesCRM AI; UNESCO XI + AI 7.000.000 đ / MST; UNESCO XI 4.500.000 đ / MST; UNESCO SALE 3.000.000 đ. Trả phí 1 lần, triển khai miễn phí, dịch vụ kế toán trên 10 MST giảm 30%." eyebrow="Bảng giá" display="BẢNG GIÁ / |SẢN PHẨM" tone="ng" subtitle="Giá từng sản phẩm, công khai và dễ so sánh">
<section class="section"><div class="container">
  <p class="price-gold"><span>Phần mềm kế toán: trả phí 1 lần sử dụng mãi mãi – Không phí hàng năm</span></p>
  <div class="pd-tabs" role="tablist" aria-label="Chọn nhóm sản phẩm">
    {families.map((f, i) => <button type="button" class="pd-tab" role="tab" id={`tab-${f.id}`} aria-controls={`panel-${f.id}`} aria-selected={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
    <button type="button" class="pd-tab" role="tab" id="tab-chinh-sach" aria-controls="panel-chinh-sach" aria-selected="false">Dịch vụ &amp; chính sách</button>
  </div>
  {families.map((f, i) => (
    <div class="pd-panel" role="tabpanel" id={`panel-${f.id}`} aria-labelledby={`tab-${f.id}`} hidden={i !== 0}>
      {f.id === 'dich-vu-ke-toan' && <p class="lead" style="margin:0 0 20px">Bộ giải pháp cho công ty dịch vụ kế toán: <b>UNESCO XII AI</b> làm sổ cho từng khách, <b>ERP_UNESCO</b> điều hành công ty, <b>UNESCO_TAX_Online</b> cho chính khách hàng của công ty. Mua UNESCO XII AI là có cả hai sản phẩm còn lại.</p>}
      <div class="pd-grid">{productsIn(f.id).map((p) => <ProductCard p={p} showService={true} />)}</div>
    </div>
  ))}
  <div class="pd-panel" role="tabpanel" id="panel-chinh-sach" aria-labelledby="tab-chinh-sach" hidden>
    <div class="grid grid-3">
      <div class="card"><h3>Triển khai</h3><p class="price" style="color:var(--blue)">Miễn phí</p><p class="muted">Khảo sát, cấu hình quy tắc hạch toán, định mức, đào tạo người dùng.</p></div>
      <div class="card"><h3>Nâng cấp</h3><p class="price" style="color:var(--yellow-d)">50% giá gói mới</p><p class="muted">Khách đang dùng UNESCO XI nâng cấp lên bản có AI.</p></div>
      <div class="card"><h3>Dịch vụ kế toán</h3><p class="price" style="color:var(--green-d)">Giảm 30%</p><p class="muted">Công ty, cá nhân làm dịch vụ kế toán mua trên 10 MST.</p></div>
    </div>
  </div>

  <div class="section-head" style="margin-top:44px"><div><span class="eyebrow">Tóm tắt</span><h2>Giá mọi sản phẩm</h2></div><p>MST là mã số thuế: mỗi công ty (bộ sổ) tính một MST.</p></div>
  <div class="table-wrap"><table class="article-table"><thead><tr><th>Sản phẩm</th><th>Giá</th><th>Ghi chú</th></tr></thead>
    <tbody>{products.map((p) => <tr><td data-label="Sản phẩm"><b>{p.name}</b></td><td data-label="Giá">{p.price}{p.unit ? ` ${p.unit}` : ''}</td><td data-label="Ghi chú">{[p.priceNote, p.serviceNote && `Dịch vụ kế toán: ${p.serviceNote}`].filter(Boolean).join(' · ')}</td></tr>)}</tbody>
  </table></div>
  <div class="motto">MINH BẠCH – CHÍNH XÁC – HIỆU QUẢ</div>
</div></section>

<section class="section surface-soft"><div class="container split"><div><span class="eyebrow">Mã kích hoạt AI</span><h2>Một mã cho mọi tính năng AI</h2><p class="lead">Gói AI được cấp bằng mã kích hoạt theo mã số thuế. Phần kế toán dùng bình thường khi chưa có mã.</p></div><div class="card"><ul class="checks"><li><b>Thời hạn:</b> vĩnh viễn khi mua bản quyền (trả phí 1 lần); phần mềm cũng cấp được mã 1, 3, 6 tháng, 1, 2 năm</li><li><b>Số công ty:</b> tính theo mã số thuế của bộ sổ</li><li><b>Số trang:</b> mỗi trang ảnh chụp hoặc PDF dạng ảnh chuyển sang Excel trừ vào số trang của mã; tệp Excel và CSV không tính; nạp thêm thì số trang cộng dồn</li><li><b>Ba chế độ:</b> đã kích hoạt / dùng thử 15 ngày / chỉ xem; mã yêu cầu riêng từng máy</li><li><b>Mã có thời hạn:</b> còn 7 ngày phần mềm nhắc gia hạn</li></ul></div></div></section>

<section class="section surface"><div class="container"><div class="section-head"><div><span class="eyebrow">So sánh</span><h2>UNESCO XI và UNESCO XI + AI</h2></div><p>AI làm việc trên chính bộ sổ UNESCO, nên doanh nghiệp đang dùng UNESCO XI có thể kích hoạt AI khi cần.</p></div>
  <div class="table-wrap"><table class="compare"><thead><tr><th>Chức năng</th><th class="c">UNESCO XI</th><th class="c">UNESCO XI + AI</th></tr></thead><tbody>{rows.map((r) => <tr><td>{r[0]}</td><td class={r[1] ? 'y' : 'n'}>{r[1] ? '✓' : '—'}</td><td class={r[2] ? 'y' : 'n'}>{r[2] ? '✓' : '—'}</td></tr>)}</tbody></table></div>
</div></section>

<section class="section surface-soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Trước khi báo giá</span><h2>4 thông tin giúp xác định đúng gói</h2></div><p>Chuẩn bị trước các thông tin này, bộ phận kinh doanh sẽ báo giá nhanh và chính xác hơn.</p></div><div class="grid grid-4"><div class="card"><h3>Loại hình</h3><p class="muted">Thương mại, dịch vụ, sản xuất, xây dựng, hộ kinh doanh hoặc kế toán dịch vụ.</p></div><div class="card"><h3>Số công ty</h3><p class="muted">Số bộ sổ (mã số thuế) cần quản lý và số máy sử dụng.</p></div><div class="card"><h3>Khối lượng AI</h3><p class="muted">Số hoá đơn mỗi tháng, ngân hàng đang dùng, sao kê dạng tệp hay ảnh chụp.</p></div><div class="card"><h3>Dữ liệu hiện có</h3><p class="muted">Phần mềm đang dùng và nhu cầu chuyển số dư đầu kỳ.</p></div></div></div></section>

<section class="section"><div class="container"><div class="quote-band"><div><h2>Liên hệ để nhận báo giá phù hợp</h2><p>{contact.sales.label}: {contact.sales.mobile} · Email: {contact.email}</p></div><div class="actions"><a class="btn btn-primary" href={telHref(contact.sales.mobile)}>GỌI {contact.sales.mobile}</a><a class="btn btn-secondary" href={zaloHref} target="_blank" rel="noopener">NHẮN ZALO</a></div></div></div></section>
<ProductVideoModal />
<ScreenViewer title="Ảnh màn hình sản phẩm UNESCO" />
<script is:inline>
(function(){
  var tabs=document.querySelectorAll('.pd-tab');
  function sel(t){tabs.forEach(function(x){var on=x===t;x.setAttribute('aria-selected',String(on));var p=document.getElementById(x.getAttribute('aria-controls'));if(p)p.hidden=!on;});}
  tabs.forEach(function(t){t.addEventListener('click',function(){sel(t);});});
  var h=location.hash.replace('#','');if(h){var t=document.getElementById('tab-'+h);if(t)sel(t);}
})();
</script>
</ContentLayout>
