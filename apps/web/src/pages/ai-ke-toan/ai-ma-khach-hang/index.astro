---
import ContentLayout from '../../../layouts/ContentLayout.astro';
const cards = [["Ưu tiên dữ liệu có căn cứ", "Mã có sẵn, MST, tên, tài khoản ngân hàng và lịch sử.", "#"], ["Đề xuất mới", "Không tự ý thay đổi danh mục lõi khi chưa được người dùng kiểm tra.", "#"], ["Giải thích được", "Hiển thị căn cứ và mức tin cậy phù hợp.", "#"]];
---
<ContentLayout title="AI hỗ trợ mã khách hàng và nhà cung cấp" description="Đối chiếu mã, MST, tên chuẩn hóa, lịch sử và các dấu hiệu nghiệp vụ để hỗ trợ xác định đối tượng.">
<section class="section"><div class="container"><div class="grid grid-3">{cards.map(c=><a class="card" href={c[2]}><h3>{c[0]}</h3><p class="muted">{c[1]}</p><strong style="color:var(--primary)">Xem thêm →</strong></a>)}</div></div></section>
<section class="section surface"><div class="container"><div class="notice"><strong>Nguyên tắc kiểm soát:</strong> nội dung website chỉ mô tả tính năng đã được công bố theo phiên bản; AI tạo phân tích/gợi ý và người dùng kiểm tra trước các nghiệp vụ cần phê duyệt.</div><div class="actions" style="margin-top:24px"><a class="btn btn-primary" href="/lien-he/#demo">ĐĂNG KÝ XEM DEMO</a><a class="btn btn-secondary" href="/lien-he/">NHẬN TƯ VẤN</a></div></div></section>
</ContentLayout>
