---
import { url } from '../../../utils/url';
import ContentLayout from '../../../layouts/ContentLayout.astro';
---
<ContentLayout title="AI hỗ trợ xử lý hóa đơn điện tử cho kế toán" description="Từ XML, Excel, PDF hoặc hình ảnh đến dữ liệu hóa đơn có cấu trúc để kế toán kiểm tra, đối chiếu và tiếp tục hạch toán." eyebrow="AI hóa đơn điện tử">
<section class="section"><div class="container split"><div class="visual-card"><img src={url('/visuals/invoice-ai.svg')} width="1200" height="820" alt="AI UNESCO đọc và phân tích hóa đơn điện tử"/></div><div><span class="eyebrow">Đọc đúng dữ liệu cần dùng</span><h2>Không chỉ OCR — đưa hóa đơn về cấu trúc nghiệp vụ</h2><p class="lead">Mục tiêu không dừng ở nhận diện chữ. Dữ liệu phải được tách đúng trường, đúng dòng hàng và có thể đối chiếu với danh mục kế toán hiện hữu.</p><div class="feature-list"><div class="feature-row"><span class="check">1</span><div><strong>Thông tin hóa đơn</strong><span>MST, tên nhà cung cấp, số, ký hiệu, ngày và trạng thái theo dữ liệu nguồn.</span></div></div><div class="feature-row"><span class="check">2</span><div><strong>Số tiền & thuế</strong><span>Tiền hàng, thuế suất, thuế GTGT, chiết khấu/phí nếu có và tổng thanh toán.</span></div></div><div class="feature-row"><span class="check">3</span><div><strong>Dòng hàng</strong><span>Tên hàng, ĐVT, số lượng, đơn giá và các trường phục vụ gợi ý vật tư.</span></div></div></div><a class="btn btn-primary" href={url('/lien-he/#demo')}>XEM DEMO AI HÓA ĐƠN</a></div></div></section>
<section class="section surface-soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Quy trình</span><h2>6 bước để biến hóa đơn thành dữ liệu có thể kiểm soát</h2></div><p>Mỗi bước tách riêng giúp người dùng biết dữ liệu nào đến từ chứng từ gốc và dữ liệu nào là đề xuất của AI.</p></div><div class="process-grid"><div class="process-step"><span class="num">01</span><strong>Nhận file</strong><small>XML / Excel / PDF / ảnh.</small></div><div class="process-step"><span class="num">02</span><strong>Đọc cấu trúc</strong><small>Lấy trường thông tin chính.</small></div><div class="process-step"><span class="num">03</span><strong>Kiểm tra</strong><small>Phát hiện dữ liệu thiếu hoặc bất thường.</small></div><div class="process-step"><span class="num">04</span><strong>Đối chiếu</strong><small>Khách hàng/NCC, vật tư, lịch sử.</small></div><div class="process-step"><span class="num">05</span><strong>Gợi ý</strong><small>Mã đối tượng, vật tư, tài khoản.</small></div><div class="process-step"><span class="num">06</span><strong>Duyệt</strong><small>Kế toán kiểm tra trước ghi nhận.</small></div></div></div></section>
<section class="section"><div class="container grid grid-3"><div class="card"><span class="tag">NHẬN DIỆN</span><h3 style="margin-top:18px">Nhà cung cấp & hóa đơn</h3><p class="muted">Tìm đúng thông tin định danh để hạn chế thao tác nhập lại.</p></div><div class="card"><span class="tag tag-blue">ĐỐI CHIẾU</span><h3 style="margin-top:18px">Danh mục hiện có</h3><p class="muted">Ưu tiên đối tượng và vật tư đã tồn tại trước khi tạo đề xuất mới.</p></div><div class="card"><span class="tag tag-gold">KIỂM SOÁT</span><h3 style="margin-top:18px">Tách dữ liệu gốc và gợi ý</h3><p class="muted">Người dùng biết phần nào đọc từ hóa đơn và phần nào cần quyết định nghiệp vụ.</p></div></div></section>
<section class="section surface"><div class="container"><div class="notice"><strong>Nguyên tắc kiểm soát:</strong> AI tạo phân tích và gợi ý theo dữ liệu có sẵn; kế toán kiểm tra chứng từ, danh mục và nghiệp vụ trước khi phê duyệt.</div></div></section>
</ContentLayout>
