---
import { url } from '../../../utils/url';
import ContentLayout from '../../../layouts/ContentLayout.astro';
const cards = [["PDF dạng ảnh quét", "Nhận dạng nội dung trong tài liệu quét.", "#"], ["Hình chụp", "Lấy đúng phần dữ liệu cần thiết.", "#"], ["Kiểm tra lại", "Dữ liệu đọc từ ảnh phải được đối chiếu trước khi dùng cho nghiệp vụ.", "#"]];
---
<ContentLayout title="AI OCR cho chứng từ kế toán" description="Hỗ trợ đọc PDF dạng ảnh quét và hình chụp khi dữ liệu chưa có định dạng sẵn.">
<section class="section"><div class="container"><div class="grid grid-3">{cards.map(c => c[2] === "#" ? <div class="card"><h3>{c[0]}</h3><p class="muted">{c[1]}</p></div> : <a class="card" href={url(c[2])}><h3>{c[0]}</h3><p class="muted">{c[1]}</p><strong style="color:var(--primary)">Xem thêm →</strong></a>)}</div></div></section>
<section class="section surface"><div class="container"><div class="notice"><strong>Nguyên tắc kiểm soát:</strong> trang này chỉ nêu tính năng đã có trong bản phần mềm hiện hành. AI đưa ra phân tích và gợi ý; kế toán kiểm tra rồi mới duyệt ghi sổ.</div><div class="actions" style="margin-top:24px"><a class="btn btn-primary" href={url('/lien-he/#demo')}>ĐĂNG KÝ XEM DEMO</a><a class="btn btn-secondary" href={url('/lien-he/')}>NHẬN TƯ VẤN</a></div></div></section>
</ContentLayout>
