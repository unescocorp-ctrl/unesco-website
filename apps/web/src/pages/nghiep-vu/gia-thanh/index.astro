---
import { url } from '../../../utils/url';
import ContentLayout from '../../../layouts/ContentLayout.astro';
import Screenshot from '../../../components/Screenshot.astro';
import { shots } from '../../../data/screenshots';
---
<ContentLayout title="Tính giá thành sản xuất và xây dựng" description="Tập hợp chi phí, quản lý định mức, phân bổ, dở dang và giá thành theo đối tượng trong cùng quy trình kế toán." eyebrow="Giá thành">
<section class="section"><div class="container split"><div><Screenshot shot={shots.costByObject} /></div><div><span class="eyebrow">Từ chi phí đến giá thành</span><h2>Thấy rõ chi phí hình thành ở đâu và được phân bổ như thế nào</h2><p class="lead">Dành cho doanh nghiệp cần theo dõi nguyên vật liệu, nhân công, chi phí chung và dở dang theo sản phẩm, đơn hàng, công trình hoặc hạng mục.</p><div class="feature-list"><div class="feature-row"><span class="check">✓</span><div><strong>Định mức</strong><span>So sánh định mức với phát sinh thực tế và nhận diện chênh lệch.</span></div></div><div class="feature-row"><span class="check">✓</span><div><strong>Tập hợp chi phí</strong><span>Tách NVL, nhân công, chi phí chung theo đối tượng phù hợp.</span></div></div><div class="feature-row"><span class="check">✓</span><div><strong>Phân bổ & dở dang</strong><span>Làm rõ tiêu thức phân bổ và dữ liệu đầu vào để kế toán kiểm tra.</span></div></div></div><a class="btn btn-primary" href={url('/lien-he/#demo')}>XEM DEMO GIÁ THÀNH</a></div></div></section>
<section class="section surface-soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Hai nhóm bài toán</span><h2>Một nền tảng, hai cách tổ chức giá thành phổ biến</h2></div><p>Các nghiệp vụ được trình bày theo đối tượng quản trị, không áp một mẫu chung cho mọi doanh nghiệp.</p></div><div class="grid grid-2"><div class="card"><span class="tag">SẢN XUẤT</span><h3 style="margin-top:18px">Sản phẩm, lệnh/đơn hàng, kỳ tính giá</h3><ul class="checks"><li>Nguyên vật liệu theo định mức</li><li>Nhân công trực tiếp</li><li>Chi phí sản xuất chung</li><li>Sản phẩm dở dang</li><li>Giá thành đơn vị</li></ul></div><div class="card"><span class="tag tag-blue">XÂY DỰNG</span><h3 style="margin-top:18px">Công trình, hạng mục và giai đoạn</h3><ul class="checks"><li>Vật tư theo công trình</li><li>Nhân công/hợp đồng khoán</li><li>Máy thi công và chi phí chung</li><li>Dở dang theo hạng mục</li><li>Đối chiếu chi phí với biên bản nghiệm thu</li></ul></div></div></div></section>
<section class="section"><div class="container">
  <div class="section-head"><div><span class="eyebrow">Trong phần mềm (GĐ161 – GĐ175b)</span><h2>Từ chi phí đến giá thành: trình tự có người dẫn đường</h2></div><p>Các chức năng giá thành đã có trong phần mềm; xem chi tiết ở trang AI Giá thành.</p></div>
  <ul class="checks"><li>Trình tự giá thành tháng 7 bước có đèn xanh / vàng / đỏ / xám; nút “Làm bước này” mở đúng màn hình.</li><li>Định mức theo tỷ lệ giá bán: AI đề xuất tỷ lệ giá vốn / giá bán, lập định mức NVL theo tỷ lệ và so thực tế với mục tiêu.</li><li>Trợ lý lập định mức cho sổ mới, sản phẩm mới: 4 phương pháp, độ tin cậy theo màu, kế toán xác nhận rồi mới ghi.</li><li>Kết chuyển thành phẩm có khung Cân đối AI; sổ giá thành và giá thành theo đối tượng (Thông tư 133).</li></ul>
  <div class="actions" style="margin:20px 0 30px"><a class="btn btn-secondary" href={url('/ai-ke-toan/ai-gia-thanh/')}>Xem AI Giá thành</a></div>
  <div class="notice"><strong>AI trong giá thành:</strong> ưu tiên hỗ trợ đối chiếu, đề xuất định mức/phân bổ và cảnh báo chênh lệch. Công thức kế toán chính thức phải theo cấu hình và dữ liệu được người dùng duyệt.</div></div></section>
</ContentLayout>
