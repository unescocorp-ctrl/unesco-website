---
import demo from '../../../../data/security-demo.json';
import {url} from '../../../../utils/url';
const base=url('/san-pham/unesco-security/demo-app/');
---
<!doctype html>
<html lang="vi" data-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<meta name="theme-color" content="#050908" />
<meta name="description" content="Mở trực tiếp UNESCO Security: Trung tâm điều hành, nhân sự, xếp ca, giám sát và viết bài trong cùng giao diện sản phẩm. Dữ liệu minh họa, không cần đăng nhập." />
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; connect-src 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'none'; object-src 'none'" />
<title>UNESCO Security · Demo sản phẩm trực tiếp</title>
{demo.styles.map(file=><link rel="stylesheet" href={base+file} />)}
</head>
<body>
<div id="root"></div>
<noscript>Bật JavaScript để trải nghiệm phần mềm. <a href={url('/san-pham/unesco-security/')}>Giới thiệu UNESCO Security</a></noscript>
<script is:inline type="module" src={base+demo.script}></script>
</body>
</html>
