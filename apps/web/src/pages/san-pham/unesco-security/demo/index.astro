---
import SecurityLayout from '../../../../layouts/SecurityLayout.astro';
---
<SecurityLayout title="Demo trực tiếp phần mềm quản lý bảo vệ" description="Thử soạn bài, xem trước nội dung và khám phá quy trình ca trực với dữ liệu minh họa của UNESCO Security." noindex>
<div class="sd-notice"><strong>BẢN DEMO TƯƠNG TÁC</strong> · Dữ liệu minh họa. Bài thử chỉ lưu trên trình duyệt của bạn; thao tác ở đây không đăng lên website hoặc ghi vào hệ thống vận hành.</div>
<div class="sd-shell"><aside class="sd-sidebar"><p>KHÔNG GIAN TRẢI NGHIỆM</p><button class="sd-tab" data-tab="overview">Tổng quan</button><button class="sd-tab" data-tab="shifts">Ca trực</button><button class="sd-tab active" data-tab="articles">Viết bài & website</button></aside><div class="sd-main">
<section data-panel="overview" hidden><div class="sd-title"><div><h1>Chủ động trong mỗi ca trực.</h1><p>Tổng quan một đơn vị giả lập để tìm hiểu cách theo dõi công việc.</p></div><button class="sc-button" data-open="shifts">Xem ca trực</button></div><div class="sd-stats"><article class="sd-stat"><span>Mục tiêu đang phục vụ</span><strong>3</strong><p>Tòa nhà · Kho vận · Nhà máy</p></article><article class="sd-stat"><span>Nhân viên theo lịch mẫu</span><strong>12</strong><p>Số liệu minh họa cho demo</p></article><article class="sd-stat"><span>Cần chỉ huy kiểm tra</span><strong>2</strong><p>Chưa tự động kết luận công</p></article></div><div class="sd-grid"><article class="sd-panel"><h2>Điều hành có căn cứ</h2><p>Lịch được giao, xác nhận theo ca và kiểm tra của chỉ huy giúp nhìn rõ các bước cần xử lý. Đăng nhập chỉ cho biết truy cập phần mềm.</p><button class="sc-button secondary" data-open="shifts">Khám phá các tình huống</button></article><article class="sd-panel"><h2>Mới: soạn bài ngay trong phần mềm</h2><p>Tạo bản nháp, xem trước, kiểm tra nội dung và để quản trị viên cập nhật lên website. Mỗi lần xuất bản giữ riêng phiên bản nội dung.</p><button class="sc-button" data-open="articles">Thử viết bài</button></article></div></section>
<section data-panel="shifts" hidden><div class="sd-title"><div><h1>Theo dõi ca trực</h1><p>Ba tình huống giả lập. Nhấn xem căn cứ để hiểu bước xử lý.</p></div></div><div class="sd-panel sd-table-wrap"><table class="sd-table"><thead><tr><th>Nhân viên / mục tiêu</th><th>Ca mẫu</th><th>Trạng thái</th><th>Căn cứ</th></tr></thead><tbody><tr><td>Nguyễn Văn An · Tòa nhà A</td><td>06:00–14:00</td><td><span class="sd-chip">Đã kiểm tra có mặt</span></td><td><button class="sc-button secondary" data-case="present">Xem</button></td></tr><tr><td>Trần Minh Bình · Kho B</td><td>06:00–14:00</td><td><span class="sd-chip warning">Vị trí cần xác minh</span></td><td><button class="sc-button secondary" data-case="location">Xem</button></td></tr><tr><td>Lê Quốc Cường · Nhà máy C</td><td>06:00–14:00</td><td><span class="sd-chip warning">Chưa có xác nhận mới</span></td><td><button class="sc-button secondary" data-case="late">Xem</button></td></tr></tbody></table></div><article class="sd-panel" id="case-detail" hidden style="margin-top:20px"><h2 id="case-title"></h2><p id="case-body"></p></article></section>
<section data-panel="articles"><div class="sd-title"><div><h1>Từ ý tưởng đến bài viết.</h1><p>Thử sửa nội dung bên trái và xem trang đọc cập nhật ngay bên phải.</p></div><button class="sc-button secondary" id="sample">Khôi phục bài mẫu</button></div><div class="sd-grid"><section class="sd-panel"><div class="sd-toolbar"><strong>Soạn bài</strong><span id="word-count"></span></div><form class="sd-form" id="editor"><label>Tiêu đề<input id="title" required minlength="5" maxlength="160"/></label><label>Tóm tắt<textarea id="summary" required minlength="10" maxlength="320" rows="3"></textarea></label><label>Nội dung<textarea id="body" required minlength="30" maxlength="30000" rows="13"></textarea></label><p>Dùng ## cho đề mục, - cho danh sách; tách các đoạn bằng một dòng trống.</p><div class="sd-actions"><button class="sc-button" type="submit">Lưu nháp trên máy</button><button class="sc-button secondary" type="button" id="export">Tải nội dung</button></div></form><div class="sd-actions"><button class="sc-button secondary" id="publish-demo">Thử bước xuất bản</button></div><p id="demo-status" class="sd-status" role="status" aria-live="polite">Bạn đang xem bài mẫu. Chưa lưu thay đổi.</p></section><article class="sd-preview"><span class="sc-eyebrow">XEM TRƯỚC BÀI VIẾT</span><h1 id="preview-title"></h1><p class="sc-byline">UNESCO Security · Nội dung minh họa</p><p id="preview-summary" class="sd-summary"></p><div id="preview-body"></div></article></div></section>
</div></div>
<script>
const sample={title:'Quản lý ca trực có căn cứ với UNESCO Security',summary:'Kết nối lịch trực, xác nhận của nhân viên và kiểm tra của chỉ huy trong một quy trình có thể đối soát.',body:'## Từ lịch trực đến xác minh thực tế\n\nPhân công đúng nhân viên, mục tiêu và khung giờ. Nhân viên chủ động gửi xác nhận; chỉ huy kiểm tra tình huống và căn cứ trước khi kết luận.\n\n## Quy trình dễ theo dõi\n\n- Lập và công bố lịch trực.\n- Nhân viên nhận ca, ghi nhận vào và ra.\n- Chỉ huy kiểm tra các trường hợp bất thường.\n- Đối soát bảng công trước khi phê duyệt.\n\n## Số liệu minh họa\n\nGiả định 120 bản ghi cần xử lý mỗi ngày. Nếu thời gian cho một bản ghi giảm từ 3 phút xuống 0,75 phút: 120 × (3 − 0,75) = 270 phút, tương đương 4,5 giờ. Đây là phép tính giả định, chưa phải hiệu quả đo tại khách hàng.\n\n## Hiểu đúng tín hiệu\n\nĐăng nhập không tự chứng minh đang làm việc. GPS là vị trí tại lần gửi, kèm sai số; cảnh báo không tự động trừ công hoặc lương.'};
const key='unesco-security-article-demo-v1';
const title=document.querySelector<HTMLInputElement>('#title')!,summary=document.querySelector<HTMLTextAreaElement>('#summary')!,body=document.querySelector<HTMLTextAreaElement>('#body')!,form=document.querySelector<HTMLFormElement>('#editor')!,status=document.querySelector<HTMLElement>('#demo-status')!;
const data=()=>({title:title.value,summary:summary.value,body:body.value});
function render(){document.querySelector('#preview-title')!.textContent=title.value||'Tiêu đề bài viết';document.querySelector('#preview-summary')!.textContent=summary.value;document.querySelector('#word-count')!.textContent=body.value.trim().split(/\s+/).filter(Boolean).length+' từ';const target=document.querySelector('#preview-body')!;target.replaceChildren();for(const block of body.value.split(/\n\s*\n/).filter(Boolean)){const lines=block.split('\n');const heading=block.startsWith('## ');const list=lines.every(x=>x.startsWith('- '));const el=document.createElement(heading?'h2':list?'ul':'p');if(list){for(const line of lines){const li=document.createElement('li');li.textContent=line.slice(2);el.append(li);}}else el.textContent=heading?block.slice(3):block;target.append(el);}}
function load(value:typeof sample){title.value=value.title;summary.value=value.summary;body.value=value.body;render();}
load(sample);try{const saved=JSON.parse(localStorage.getItem(key)||'null');if(saved&&typeof saved.title==='string'&&saved.title.length<=160&&typeof saved.summary==='string'&&saved.summary.length<=320&&typeof saved.body==='string'&&saved.body.length<=30000){load(saved);status.textContent='Đã mở bản nháp lưu trên trình duyệt này.';}}catch{status.textContent='Không đọc được bản nháp trên máy; đang dùng bài mẫu.';}
form.addEventListener('input',()=>{render();status.textContent='Có thay đổi chưa lưu. Bản xem trước đã cập nhật.';});
form.addEventListener('submit',e=>{e.preventDefault();try{localStorage.setItem(key,JSON.stringify(data()));status.textContent='Đã lưu nháp trên trình duyệt này. Chưa đăng lên website.';}catch{status.textContent='Trình duyệt không cho lưu. Dùng Tải nội dung để giữ bản nháp.';}});
document.querySelector('#sample')!.addEventListener('click',()=>{if(confirm('Thay nội dung đang soạn bằng bài mẫu?')){load(sample);status.textContent='Đã khôi phục bài mẫu. Nhấn Lưu nháp nếu muốn giữ trên máy.';}});
document.querySelector('#export')!.addEventListener('click',()=>{if(!form.reportValidity())return;const blob=new Blob([title.value+'\n\n'+summary.value+'\n\n'+body.value],{type:'text/plain;charset=utf-8'});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download='bai-viet-unesco.txt';link.click();setTimeout(()=>URL.revokeObjectURL(link.href),1000);status.textContent='Đã tạo tệp nội dung để tải về.';});
document.querySelector('#publish-demo')!.addEventListener('click',()=>{if(form.reportValidity())status.textContent='Bước demo: quản trị viên kiểm tra nội dung, xác nhận công khai rồi gửi bản đã lưu lên website. Bản demo này không thực hiện xuất bản; bài của bạn vẫn chỉ ở trình duyệt.';});
function tab(name:string){document.querySelectorAll<HTMLElement>('[data-panel]').forEach(el=>el.hidden=el.dataset.panel!==name);document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach(el=>{el.classList.toggle('active',el.dataset.tab===name);el.setAttribute('aria-pressed',String(el.dataset.tab===name));});}
document.querySelectorAll<HTMLButtonElement>('[data-tab],[data-open]').forEach(el=>el.addEventListener('click',()=>tab(el.dataset.tab||el.dataset.open!)));
const cases:Record<string,[string,string]>={present:['Có mặt đã được kiểm tra','Ví dụ: lịch 06:00–14:00; nhân viên gửi xác nhận lúc 06:02, vị trí trong vùng cấu hình và chỉ huy đã kiểm tra. Kết quả này vẫn cần đối soát theo quy trình chấm công của đơn vị.'],location:['Vị trí cần xác minh','Ví dụ: khoảng cách 180 m, sai số vị trí 120 m. Cần hỏi nhân viên, kiểm tra vị trí chốt và điều kiện thiết bị. Tín hiệu ngoài vùng chưa đủ căn cứ kết luận tự ý rời vị trí.'],late:['Chưa có xác nhận mới','Ví dụ: quá mốc cần gửi 15 phút. Chỉ huy cần liên hệ, kiểm tra tình trạng mạng và hiện trường. Trạng thái này không tự trở thành vắng mặt hoặc trừ lương.']};
document.querySelectorAll<HTMLButtonElement>('[data-case]').forEach(el=>el.addEventListener('click',()=>{const [title,text]=cases[el.dataset.case!];document.querySelector('#case-title')!.textContent=title;document.querySelector('#case-body')!.textContent=text;document.querySelector<HTMLElement>('#case-detail')!.hidden=false;}));
tab('articles');
</script></SecurityLayout>
