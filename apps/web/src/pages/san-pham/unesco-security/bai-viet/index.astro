---
import SecurityLayout from '../../../../layouts/SecurityLayout.astro';
import {securityArticles} from '../../../../data/security-articles';
import {url} from '../../../../utils/url';
---
<SecurityLayout title="Bài viết & hướng dẫn vận hành" description="Kinh nghiệm quản lý dịch vụ bảo vệ, hướng dẫn UNESCO Security và cập nhật tính năng từ đội ngũ UNESCO."><section class="sc-hero"><span class="sc-eyebrow">KIẾN THỨC ĐỂ VẬN HÀNH TỐT HƠN</span><h1>Bài viết &<br/>hướng dẫn vận hành.</h1><p>Cập nhật tính năng, thực hành theo quy trình và những điều cần kiểm tra trước khi đưa vào sử dụng.</p><a class="sc-button" href={url('/san-pham/unesco-security/demo/')}>Trải nghiệm phần mềm</a></section><section class="sc-section"><div class="sc-section-title"><h2>Nội dung mới nhất</h2><span>{securityArticles.length} bài viết</span></div><div class="sc-cards">{securityArticles.map(a=><article class="sc-card"><span class="sc-eyebrow">{a.category}</span><h2><a href={url('/san-pham/unesco-security/bai-viet/'+a.slug+'/')}>{a.title}</a></h2><p>{a.summary}</p><footer>{a.author} · {new Date(a.publishedAt).toLocaleDateString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'})}</footer><a class="sc-link" href={url('/san-pham/unesco-security/bai-viet/'+a.slug+'/')}>Đọc bài viết</a></article>)}<article class="sc-card"><span class="sc-eyebrow">TỔNG QUAN GIẢI PHÁP</span><h2>Quản lý công ty dịch vụ bảo vệ với UNESCO Security</h2><p>Tìm hiểu luồng nhân sự, lịch trực, xác nhận ca và đối soát công, lương trong phần mềm.</p><a class="sc-link" href={url('/san-pham/unesco-security/bai-gioi-thieu/')}>Đọc bài giới thiệu</a></article></div></section></SecurityLayout>
