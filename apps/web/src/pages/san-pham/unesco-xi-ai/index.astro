import { url } from '../../../utils/url';
import ContentLayout from '../../../layouts/ContentLayout.astro';
import LeadForm from '../../../components/LeadForm.astro';
---
<ContentLayout title="UNESCO XI + AI – Phần mềm kế toán kết hợp trợ lý AI" description="Kết hợp hệ thống kế toán UNESCO XI với lớp AI hỗ trợ đọc dữ liệu, phân tích nghiệp vụ và đưa đề xuất vào đúng nơi kế toán cần kiểm tra." eyebrow="Sản phẩm chủ lực">
<section class="section"><div class="container split"><div class="visual-card"><img src={url('/visuals/hero-ai-accounting.svg')} width="1440" height="940" alt="Giao diện minh họa UNESCO XI + AI"/></div><div><span class="eyebrow">Một hệ thống thống nhất</span><h2>Từ chứng từ đầu vào đến sổ sách, báo cáo và kiểm soát dữ liệu</h2><p class="lead">UNESCO XI + AI không tách AI thành một công cụ rời. Các đề xuất được đặt trong ngữ cảnh nghiệp vụ kế toán để người dùng dễ đối chiếu và phê duyệt.</p><div class="feature-list"><div class="feature-row"><span class="check">✓</span><div><strong>AI hóa đơn</strong><span>Đọc dữ liệu, dòng hàng và gợi ý thông tin liên quan.</span></div></div><div class="feature-row"><span class="check">✓</span><div><strong>AI sổ phụ</strong><span>Chuẩn hóa nội dung, truy vết đối tượng và hỗ trợ gợi ý tài khoản.</span></div></div><div class="feature-row"><span class="check">✓</span><div><strong>Giá thành</strong><span>Tập hợp chi phí sản xuất, xây dựng và hỗ trợ đối chiếu định mức.</span></div></div><div class="feature-row"><span class="check">✓</span><div><strong>Sổ sách & báo cáo</strong><span>Dữ liệu đã kiểm tra đi tiếp trong quy trình kế toán hiện hữu.</span></div></div></div><div class="actions"><a class="btn btn-primary" href={url('/lien-he/#demo')}>ĐĂNG KÝ DEMO</a><a class="btn btn-secondary" href={url('/download/')}>DOWNLOAD CENTER</a></div></div></div></section>
<section class="section surface-soft"><div class="container"><div class="section-head"><div><span class="eyebrow">4 lớp giá trị</span><h2>AI được đặt đúng chỗ trong quy trình kế toán</h2></div><p>Không tạo “hộp đen” tự động. Website giải thích rõ dữ liệu đến từ đâu, AI đề xuất gì và điểm nào cần kế toán duyệt.</p></div><div class="grid grid-4"><div class="card"><span class="tag">01 · INPUT</span><h3 style="margin-top:18px">Thu nhận dữ liệu</h3><p class="muted">Hóa đơn, bảng tính, PDF, ảnh và dữ liệu ngân hàng theo phạm vi hỗ trợ.</p></div><div class="card"><span class="tag tag-blue">02 · AI</span><h3 style="margin-top:18px">Phân tích & đối chiếu</h3><p class="muted">Chuẩn hóa nội dung, tìm dữ kiện liên quan và tạo candidate phù hợp.</p></div><div class="card"><span class="tag tag-gold">03 · REVIEW</span><h3 style="margin-top:18px">Kế toán kiểm tra</h3><p class="muted">Hiển thị đề xuất, dữ liệu tham chiếu và mức tin cậy để người dùng quyết định.</p></div><div class="card"><span class="tag">04 · OUTPUT</span><h3 style="margin-top:18px">Sổ sách & báo cáo</h3><p class="muted">Dữ liệu sau duyệt tiếp tục vào hệ thống kế toán, không tạo luồng rời rạc.</p></div></div></div></section>
<section class="section"><div class="container"><div class="quote-band"><div><h2>Trải nghiệm đúng bài toán của doanh nghiệp, không chỉ xem giao diện mẫu.</h2><p>Đăng ký demo để lựa chọn nhóm nghiệp vụ cần xem: hóa đơn, sổ phụ, giá thành, kế toán dịch vụ, sản xuất hoặc xây dựng.</p></div><div class="actions"><a class="btn btn-primary" href={url('/lien-he/#demo')}>XEM DEMO THỰC TẾ</a></div></div></div></section>
<section class="section surface"><div class="container"><LeadForm kind="demo" heading="Đăng ký demo UNESCO XI + AI"/></div></section>
</ContentLayout>
