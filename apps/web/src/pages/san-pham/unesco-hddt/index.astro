---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import HddtRegistration from '../../../components/HddtRegistration.astro';
import { url } from '../../../utils/url';
import { hddtRelease as r, hddtSoftwareSchema } from '../../../data/hddt';
import { site } from '../../../config/site.config';
const features = [
  { icon: 'file-xml', title: 'Giữ XML nguồn', text: 'Kiểm tra cấu trúc, nhận diện hóa đơn và lưu tệp về thư mục bạn chọn. Tải thêm PDF khi cổng cung cấp.' },
  { icon: 'search', title: 'Tìm nhanh, lọc phần thiếu', text: 'Tìm số hóa đơn, ký hiệu, MST hoặc tên đối tác bằng tiếng Việt có dấu hay không dấu.' },
  { icon: 'download', title: 'Tiếp tục sau khi dừng', text: 'Giữ tiến độ trên máy. Khi tiếp tục, ứng dụng kiểm tra và bỏ qua những tệp đã tải hợp lệ.' },
  { icon: 'folder-check', title: 'Xuất cho UNESCO XII', text: 'Gom XML thành ZIP và xuất danh sách CSV để đối chiếu. Nhập XML bằng chức năng sẵn có trong UNESCO XII.' },
];
const steps = [
  ['Giải nén và mở', 'Đăng ký email, số điện thoại và tải ZIP. Giải nén toàn bộ rồi mở UNESCO_HDDT_DocLap.exe. Giữ thư mục _internal đi kèm; không cần cài Python.'],
  ['Đăng nhập trong ứng dụng', 'Nhập MST, mật khẩu và tự điền CAPTCHA. Phần mềm kết nối cổng thuế ngay trong cửa sổ riêng.'],
  ['Chọn kỳ và đồng bộ', 'Chọn ngày, mua vào/bán ra và loại hóa đơn. Đồng bộ danh sách, kiểm tra thông báo phạm vi còn thiếu.'],
  ['Tải và đối chiếu', 'Chọn thư mục, tải XML/PDF. Kiểm tra số lượng và nội dung; xuất XML cho UNESCO khi cần.'],
];
---
<BaseLayout title="UNESCO HĐĐT – Phần mềm tải hóa đơn miễn phí" description="Tải miễn phí UNESCO HĐĐT độc lập cho Windows: đăng nhập trong ứng dụng, lưu XML/PDF, tìm hóa đơn, tiếp tục phần thiếu và xuất XML cho UNESCO XII. Bản thử nghiệm 0.1.3, giao diện nền trắng; đăng ký email và số điện thoại để tải." image={r.imagePath} schema={hddtSoftwareSchema} crumbs={[["Trang chủ", "/"], ["Sản phẩm", "/san-pham/"], ["UNESCO HĐĐT", r.pagePath]]}>
  <div class="hddt-page">
    <section class="hddt-hero">
      <div class="container">
        <nav class="hddt-crumb" aria-label="Vị trí trang"><a href={url('/san-pham/')}>Sản phẩm UNESCO</a><span>/</span><span>UNESCO HĐĐT</span></nav>
        <div class="hero-grid">
          <div><p class="eyebrow">UNESCO HĐĐT ĐỘC LẬP</p><h1>Hóa đơn về máy.<br/><span>Công việc gọn hơn.</span></h1><p class="hero-lead">Công cụ tải và lưu hóa đơn XML/PDF với giao diện đăng nhập riêng. Tìm nhanh, tải tiếp phần còn thiếu và xuất XML cho UNESCO XII.</p><div class="hero-tags"><span>Đăng nhập trong ứng dụng</span><span>Dữ liệu lưu tại máy</span><span>XML trước, PDF sau</span></div><div class="hero-actions"><a class="download-button" href={url(r.pagePath+"demo/")}>Dùng thử demo trên web</a><a class="hero-guide" href="#huong-dan">Hướng dẫn sử dụng</a></div></div>
          <div class="download-panel" id="tai-mien-phi"><span class="preview-tag">Bản thử nghiệm {r.version}</span><p class="price-label">Giá sử dụng</p><p class="free-price">Miễn phí <span>0 đ</span></p><p class="download-copy">Dùng thử demo trên web. Đăng ký email và số điện thoại để tải bản Windows miễn phí.</p><a class="download-button" data-hddt-download href="#dang-ky-tai"><Icon name="download" size={22}/>Đăng ký tải miễn phí</a><p class="file-meta">Windows 11 64-bit · ZIP {r.sizeLabel}<br/>Phát hành {r.publishedDate}</p><a class="small-link" href={url(r.guidePath)} download>Tải hướng dẫn sử dụng</a></div>
        </div>
        <div class="preview-note"><Icon name="info" size={22}/><p><strong>Lưu ý về bản thử nghiệm:</strong> chưa nghiệm thu đăng nhập và tải bằng tài khoản thuế thật. Hãy thử một kỳ nhỏ và đối chiếu kết quả trước khi sử dụng chính thức.</p></div>
        <figure class="app-preview"><div class="preview-top"><span>Giao diện UNESCO HĐĐT</span><span>Dữ liệu minh họa</span></div><a href={url(r.imagePath)} target="_blank" rel="noopener" aria-label="Mở ảnh giao diện UNESCO HĐĐT kích thước đầy đủ"><img src={url(r.imagePath)} width="1450" height="940" alt="Giao diện UNESCO HĐĐT nền trắng, logo UNESCO góc trái, đăng nhập bên trái và bảng hóa đơn minh họa bên phải" fetchpriority="high"/></a><figcaption>Ảnh bản Windows nền trắng 0.1.3. Các hóa đơn trong ảnh là dữ liệu tổng hợp.</figcaption></figure>
      </div>
    </section>
    <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Tập trung vào hóa đơn</span><h2>Từ danh sách đến tệp cần lưu</h2></div><p>Chạy độc lập trên Windows. Không cần mua UNESCO XII để sử dụng công cụ tải.</p></div><div class="feature-grid">{features.map(f=><article><span class="feature-icon"><Icon name={f.icon} size={26}/></span><h3>{f.title}</h3><p>{f.text}</p></article>)}</div></div></section>
    <HddtRegistration/>
    <section class="section guide-section" id="huong-dan"><div class="container"><span class="eyebrow">Bắt đầu sử dụng</span><h2>Bốn bước ngay trong ứng dụng</h2><ol class="hddt-steps">{steps.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol><div class="guide-note"><strong>Chọn đúng phạm vi:</strong> khi chọn dòng, tải/xuất chỉ áp dụng các dòng đó. Nếu chưa chọn, ứng dụng xử lý toàn bộ bảng đang hiển thị. Xóa tìm kiếm và chọn “Tất cả tệp” để xem lại cả danh sách.</div></div></section>
    <section class="section"><div class="container details-grid"><div><span class="eyebrow">Trước khi sử dụng</span><h2>Rõ cách hoạt động,<br/>rõ phạm vi hỗ trợ.</h2><p>Demo trên web dùng dữ liệu mẫu. Bản Windows tải sau khi đăng ký; tài khoản cổng thuế chỉ nhập trong ứng dụng trên máy.</p><div class="support-box"><strong>{site.company.legalName}</strong><a href="tel:+842837555755">Hỗ trợ: {site.company.phone}</a><a href={`mailto:${site.company.supportEmail}`}>{site.company.supportEmail}</a></div></div><div class="faq-list">
      <details open><summary>Miễn phí gồm những gì?</summary><p>Đăng ký email và số điện thoại để tải và sử dụng bản {r.version} miễn phí. Thông tin được lưu để xử lý đăng ký và hỗ trợ; lượt tải dùng một lần, có hạn 15 phút. Không cần mã kích hoạt công cụ. Mức giá này áp dụng cho UNESCO HĐĐT độc lập; các sản phẩm kế toán khác có bảng giá riêng.</p></details>
      <details><summary>Ứng dụng có mở trang thuế trong trình duyệt không?</summary><p>Không. Bạn nhập thông tin và CAPTCHA trong cửa sổ ứng dụng. Kết nối vẫn cần Internet và tài khoản hợp lệ. Nếu cổng từ chối kết nối trực tiếp, ứng dụng báo lỗi và dừng.</p></details>
      <details><summary>Demo trên web có tải hóa đơn thật không?</summary><p>Demo cho phép đồng bộ dữ liệu mẫu, tìm kiếm, chọn hóa đơn, mô phỏng tải và xuất CSV mẫu. Demo không kết nối cổng thuế, không nhận mật khẩu và không tạo hóa đơn có giá trị kê khai.</p></details>
      <details><summary>Mật khẩu và dữ liệu được lưu ở đâu?</summary><p>Mật khẩu, CAPTCHA và phiên đăng nhập chỉ giữ trong bộ nhớ, không lưu vào cấu hình. XML/PDF và tiến độ nằm trên máy; lần mở sau cần đăng nhập lại. Website này không có biểu mẫu nhận mật khẩu thuế.</p></details>
      <details><summary>Cần lưu ý gì khi dùng bản thử nghiệm?</summary><p>Đã kiểm tra bản chạy trên Windows 11 64-bit và 62 kiểm thử bằng dữ liệu tổng hợp. Chưa nghiệm thu tài khoản thuế thật, các dạng XML/PDF thực tế, lô dữ liệu lớn hoặc Windows khác. Kiểm tra XML và hash chưa phải xác minh chữ ký số; phần mềm không tự ghi sổ.</p></details>
      <details><summary>Làm sao tiếp tục hoặc nâng cấp?</summary><p>Đóng bản cũ rồi giải nén bản mới vào thư mục riêng. Giữ dữ liệu tiến độ và các XML/PDF đã tải. Đăng nhập lại, chọn cùng kỳ và tải phần thiếu; kiểm tra lại thư mục đầu ra trước khi bắt đầu.</p></details>
      <details><summary>Kiểm tra gói tải như thế nào?</summary><p>EXE hiện chưa có chữ ký số nhà phát hành. Gói ZIP có danh sách kiểm tra tệp và giấy phép thư viện đi kèm. Bạn có thể đối chiếu mã SHA-256 dưới đây với gói đã tải.</p><code>{r.sha256}</code><a href={url("/downloads/unesco-hddt/UNESCO_HDDT_0_1_3_Windows_x64.zip.sha256")} download>Tải tệp SHA-256</a></details>
    </div></div></section>
    <section class="bottom-download"><div class="container"><div><h2>UNESCO HĐĐT — Miễn phí</h2><p>Bản thử nghiệm {r.version} · Windows 11 64-bit</p></div><a class="download-button" data-hddt-download href="#dang-ky-tai"><Icon name="download" size={22}/>Đăng ký tải phần mềm</a></div></section>
  </div>
</BaseLayout>
<style>
.hero-actions{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:1.4rem}.hddt-page{background:#fff;font-size:1rem;line-height:1.65}.hddt-hero{background:#ffffff;color:#294a3a;padding:1.5rem 0 3rem}.hddt-crumb{display:flex;gap:.7rem;font-size:.875rem;color:#526c5c;margin-bottom:3rem}.hddt-crumb a{color:#236d49}.hero-grid{display:grid;grid-template-columns:1.45fr 1fr;gap:5rem;align-items:center}.hddt-hero .eyebrow{color:#087549;letter-spacing:.12em}.hddt-hero h1{color:#183f2c;font-size:clamp(2.2rem,4.7vw,4rem);line-height:1.13;letter-spacing:-.035em;margin:.8rem 0 1.5rem}.hddt-hero h1 span{color:#087549}.hero-lead{font-size:1.15rem;line-height:1.8;max-width:38rem;color:#486353}.hero-tags{display:flex;gap:.5rem;flex-wrap:wrap;margin:1.5rem 0}.hero-tags span{border:1px solid #bddbc9;border-radius:6px;padding:.35rem .65rem;font-size:.85rem;color:#38634b}.hero-guide{color:#09683f;font-weight:600;text-decoration:underline;text-underline-offset:5px}.download-panel{border:1px solid #bfdcc9;border-radius:22px;padding:2rem;background:#ffffff;box-shadow:0 15px 45px #17422b12}.preview-tag{display:inline-block;font-size:.875rem;border-radius:20px;background:#edf8f1;color:#286044;padding:.3rem .8rem}.price-label{margin:1.5rem 0 0;color:#4c6c59}.free-price{font-size:2.65rem;font-weight:800;color:#087847;margin:0;letter-spacing:-.03em}.free-price span{font-size:1.2rem;white-space:nowrap;font-weight:500;border-left:1px solid #b3d0be;padding-left:1rem;margin-left:.5rem}.download-copy{color:#486353;font-size:1rem;margin:1rem 0 1.4rem}.download-button{display:inline-flex;align-items:center;justify-content:center;gap:.65rem;background:#087b4d;border:1px solid #087b4d;color:#ffffff;font-size:1rem;font-weight:800;padding:1rem 1.2rem;border-radius:10px;text-align:center;text-decoration:none;min-height:54px}.download-button:hover{background:#065f3b;color:#ffffff;box-shadow:0 0 0 3px #7fe9bd40}.download-panel .download-button{width:100%}.file-meta{font-size:.875rem;color:#526d5c;text-align:center;margin:1rem 0}.small-link{font-size:.9rem;color:#09683f;text-align:center;display:block;text-decoration:underline}.preview-note{display:flex;gap:.8rem;align-items:flex-start;padding:1rem 1.25rem;border-left:3px solid #e6c67b;background:#fff9eb;border-radius:0 10px 10px 0;margin:2.5rem 0 2rem;color:#5d5338;font-size:.95rem}.preview-note :global(svg){flex:none;margin-top:.2rem;color:#f1d490}.preview-note p{margin:0}.app-preview{margin:0;border:1px solid #c7ddcf;border-radius:14px;overflow:hidden;background:#fff;box-shadow:0 15px 35px #17422b0d}.preview-top{display:flex;justify-content:space-between;gap:1rem;padding:.85rem 1.2rem;background:#eff7f2;color:#385d47;font-size:.875rem}.app-preview img{display:block;width:100%;height:auto}.app-preview figcaption{color:#526b5b;font-size:.875rem;padding:.9rem 1.2rem}.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem}.feature-icon{display:inline-flex;padding:.75rem;border-radius:12px;background:#e7f5ef;color:#08764f}.feature-grid h3{margin:1.1rem 0 .7rem;font-size:1.2rem}.feature-grid p{margin:0;color:#4c6371}.guide-section{background:#edf5f5}.hddt-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;list-style:none;padding:0;margin:2rem 0;counter-reset:step}.hddt-steps li{counter-increment:step}.hddt-steps li:before{content:counter(step);display:inline-grid;place-items:center;width:2.3rem;height:2.3rem;border-radius:50%;background:#0a6c57;color:white;font-weight:800;margin-bottom:1rem}.hddt-steps h3{font-size:1.1rem;margin:0 0 .6rem}.hddt-steps p{color:#4a626c;margin:0}.guide-note{padding:1.2rem;background:white;border:1px solid #c2ddd6;border-radius:10px;color:#31545b}.details-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:4rem}.details-grid p{color:#4d6570}.support-box{display:flex;flex-direction:column;gap:.5rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid #cfdfdc}.support-box a{color:#147454}.faq-list details{padding:1.15rem 0;border-bottom:1px solid #ccddd9}.faq-list details:first-child{border-top:1px solid #ccddd9}.faq-list summary{font-size:1rem;font-weight:700;color:#193c49;cursor:pointer;min-height:24px}.faq-list p{margin:1rem 0 0}.faq-list code{display:block;word-break:break-all;font-size:.8rem;background:#edf4f2;color:#2b4d53;padding:.8rem;margin:.7rem 0}.faq-list a{color:#087453;text-decoration:underline}.bottom-download{background:#f2f8f4;padding:2.8rem 0;color:#3b5d48}.bottom-download .container{display:flex;align-items:center;justify-content:space-between;gap:2rem}.bottom-download h2{color:#183f2c;font-size:1.9rem;margin:0}.bottom-download p{margin:.5rem 0 0}.hddt-page a:focus-visible,.hddt-page summary:focus-visible{outline:3px solid #2db68f;outline-offset:5px}@media(max-width:1000px){.hero-grid{gap:2rem;grid-template-columns:1.2fr 1fr}.feature-grid,.hddt-steps{grid-template-columns:repeat(2,1fr)}.details-grid{gap:2rem}}@media(max-width:700px){.hddt-hero{padding-top:1rem}.hddt-crumb{margin-bottom:2rem}.hero-grid,.details-grid{grid-template-columns:1fr}.download-panel{padding:1.5rem}.preview-note{margin-top:1.8rem}.feature-grid,.hddt-steps{gap:1.5rem}.preview-top{font-size:.8rem;padding:.8rem}.bottom-download .container{align-items:flex-start;flex-direction:column}.bottom-download .download-button{width:100%}.details-grid{gap:2rem}.hero-lead{font-size:1.05rem}.hero-tags span{font-size:.8rem}}@media(max-width:420px){.feature-grid,.hddt-steps{grid-template-columns:1fr}.free-price{font-size:2.3rem}.free-price span{font-size:1rem}}
</style>
