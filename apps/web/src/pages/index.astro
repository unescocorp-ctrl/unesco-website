---
import { url } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import LeadForm from '../components/LeadForm.astro';
import { aiFeatures } from '../data/features';
const solutionCards = [
  ['🧑‍💼','Kế toán dịch vụ','Quản lý nhiều doanh nghiệp, xử lý hóa đơn và sổ phụ theo quy trình thống nhất.','/giai-phap/ke-toan-dich-vu/'],
  ['🏪','Bán lẻ & TMĐT','Hỗ trợ khối lượng giao dịch lớn, doanh thu và hàng hóa phát sinh theo ngày.','/giai-phap/thuong-mai-dien-tu/'],
  ['🏭','Sản xuất','Định mức, nguyên vật liệu, chi phí, dở dang và tính giá thành theo đối tượng.','/giai-phap/san-xuat/'],
  ['🏗️','Xây dựng','Theo dõi công trình, hạng mục, vật tư và tập hợp chi phí theo đối tượng.','/giai-phap/xay-dung/'],
];
---
<BaseLayout title="Phần mềm kế toán UNESCO XI + AI" description="UNESCO XI + AI hỗ trợ hóa đơn điện tử, sổ phụ ngân hàng, gợi ý hạch toán, giá thành và báo cáo kế toán.">
<section class="hero"><div class="container hero-grid">
  <div>
    <span class="eyebrow">Phần mềm kế toán UNESCO XI + AI</span>
    <h1>Kế toán nhanh hơn.<br/><span>Tự động hơn.</span><br/>Kiểm soát tốt hơn.</h1>
    <p class="lead">Kết hợp hệ thống kế toán UNESCO với lớp hỗ trợ AI để đọc chứng từ, phân tích sổ phụ, gợi ý nghiệp vụ, tập hợp giá thành và đưa dữ liệu đã kiểm tra vào sổ sách – báo cáo.</p>
    <div class="actions"><a class="btn btn-primary" href={url('/lien-he/#demo')}>ĐĂNG KÝ XEM DEMO</a><a class="btn btn-secondary" href={url('/san-pham/unesco-xi-ai/')}>XEM UNESCO XI + AI</a></div>
    <div class="hero-proof"><span class="proof-pill">Hóa đơn điện tử</span><span class="proof-pill">Sổ phụ ngân hàng</span><span class="proof-pill">Giá thành</span><span class="proof-pill">Sổ sách & báo cáo</span></div>
  </div>
  <div class="hero-visual"><img src={url('/visuals/hero-ai-accounting.svg')} width="1440" height="940" alt="Minh họa trung tâm điều hành kế toán UNESCO XI + AI" fetchpriority="high"/></div>
</div></section>

<section class="section-sm surface"><div class="container"><div class="trust-strip"><div class="trust-item"><strong>AI hỗ trợ</strong><span>Phân tích, đối chiếu và tạo gợi ý</span></div><div class="trust-item"><strong>Kế toán kiểm soát</strong><span>Duyệt trước nghiệp vụ cần kiểm tra</span></div><div class="trust-item"><strong>Dữ liệu xuyên suốt</strong><span>Từ chứng từ đến sổ sách – báo cáo</span></div><div class="trust-item"><strong>Triển khai theo phiên bản</strong><span>Tính năng công bố rõ phạm vi hỗ trợ</span></div></div></div></section>

<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">AI cho nghiệp vụ kế toán</span><h2>Giảm thao tác lặp lại, tăng thời gian kiểm soát số liệu</h2></div><p>UNESCO AI tập trung vào những công việc tốn thời gian: đọc dữ liệu, chuẩn hóa nội dung, tìm đối tượng, đối chiếu lịch sử và tạo đề xuất để kế toán kiểm tra.</p></div><div class="grid grid-3">{aiFeatures.map(f=><FeatureCard {...f}/>)}</div></div></section>

<section class="section surface-soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Quy trình kiểm soát</span><h2>Từ dữ liệu đầu vào đến báo cáo kế toán</h2></div><p>Mỗi bước đều có dấu vết rõ ràng. AI không thay người dùng phê duyệt những nghiệp vụ cần kiểm soát.</p></div><div class="process-grid"><div class="process-step"><span class="num">01</span><strong>Nhận dữ liệu</strong><small>Hóa đơn, Excel, PDF, ảnh, sổ phụ.</small></div><div class="process-step"><span class="num">02</span><strong>Đọc & chuẩn hóa</strong><small>Chuyển dữ liệu về cấu trúc thống nhất.</small></div><div class="process-step"><span class="num">03</span><strong>AI phân tích</strong><small>Nhận dạng nội dung và ngữ cảnh nghiệp vụ.</small></div><div class="process-step"><span class="num">04</span><strong>Đối chiếu</strong><small>Khách hàng, hóa đơn, công nợ, lịch sử.</small></div><div class="process-step"><span class="num">05</span><strong>Kế toán duyệt</strong><small>Kiểm tra gợi ý và mức tin cậy.</small></div><div class="process-step"><span class="num">06</span><strong>Sổ sách & báo cáo</strong><small>Dữ liệu sau duyệt đi tiếp trong hệ thống.</small></div></div><div class="notice" style="margin-top:26px"><strong>Nguyên tắc truyền thông:</strong> AI hỗ trợ phân tích và đề xuất; người sử dụng kiểm tra và phê duyệt trước khi ghi nhận các nghiệp vụ cần kiểm soát.</div></div></section>

<section class="section"><div class="container split"><div class="visual-card"><img src={url('/visuals/invoice-ai.svg')} width="1200" height="820" alt="Minh họa AI đọc và phân tích hóa đơn điện tử" loading="lazy"/></div><div><span class="eyebrow">AI hóa đơn điện tử</span><h2>Từ hóa đơn đến dữ liệu kế toán có cấu trúc</h2><p class="lead">Đọc các trường thông tin chính, phân tích dòng hàng và hỗ trợ gợi ý đối tượng – vật tư – tài khoản theo phạm vi dữ liệu của doanh nghiệp.</p><div class="feature-list"><div class="feature-row"><span class="check">✓</span><div><strong>Nhiều nguồn dữ liệu</strong><span>XML, Excel, PDF text, PDF scan hoặc hình ảnh theo khả năng từng phiên bản.</span></div></div><div class="feature-row"><span class="check">✓</span><div><strong>Đọc chi tiết hóa đơn</strong><span>MST, số/ký hiệu, ngày, tiền hàng, thuế, tổng thanh toán và dòng hàng.</span></div></div><div class="feature-row"><span class="check">✓</span><div><strong>Gợi ý để kiểm tra</strong><span>Mã khách hàng/NCC, vật tư và tài khoản được trình bày cho người dùng duyệt.</span></div></div></div><div class="actions"><a class="btn btn-primary" href={url('/ai-ke-toan/ai-hoa-don/')}>KHÁM PHÁ AI HÓA ĐƠN</a></div></div></div></section>

<section class="section surface"><div class="container split reverse"><div class="visual-card"><img src={url('/visuals/bank-ai.svg')} width="1200" height="820" alt="Minh họa AI phân tích sổ phụ ngân hàng" loading="lazy"/></div><div><span class="eyebrow">AI sổ phụ ngân hàng</span><h2>Đọc nội dung giao dịch theo cách kế toán có thể kiểm tra</h2><p class="lead">Chuẩn hóa nội dung không dấu hoặc khó đọc, truy vết tên đối tượng và hỗ trợ đối chiếu với khách hàng, hóa đơn, công nợ và lịch sử nghiệp vụ.</p><div class="feature-list"><div class="feature-row"><span class="check">✓</span><div><strong>Chuẩn hóa mô tả giao dịch</strong><span>Giải nghĩa viết tắt và ký hiệu theo từ điển nghiệp vụ.</span></div></div><div class="feature-row"><span class="check">✓</span><div><strong>Truy vết đối tượng</strong><span>Tìm tên người chuyển/nhận, khách hàng, nhà cung cấp hoặc nhân viên liên quan.</span></div></div><div class="feature-row"><span class="check">✓</span><div><strong>Hiển thị mức tin cậy</strong><span>Đề xuất được tách rõ để người dùng kiểm tra trước khi duyệt.</span></div></div></div><div class="actions"><a class="btn btn-tech" href={url('/ai-ke-toan/ai-so-phu-ngan-hang/')}>XEM AI SỔ PHỤ</a></div></div></div></section>

<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Giải pháp theo mô hình</span><h2>Không chỉ liệt kê chức năng — giải quyết bài toán của từng loại doanh nghiệp</h2></div><p>Mỗi landing page đi theo quy trình nghiệp vụ thực tế để khách hàng nhanh chóng thấy phần mềm phù hợp với công việc của mình ở đâu.</p></div><div class="grid grid-4">{solutionCards.map(c=><a class="card solution-card" href={url(c[3])}><div class="solution-icon">{c[0]}</div><h3>{c[1]}</h3><p class="muted">{c[2]}</p><strong class="link-arrow">Xem giải pháp</strong></a>)}</div><div class="visual-card" style="margin-top:30px"><img src={url('/visuals/solutions-ai.svg')} width="1200" height="760" alt="UNESCO XI + AI cho kế toán dịch vụ, bán lẻ, sản xuất và xây dựng" loading="lazy"/></div></div></section>

<section class="section surface-soft"><div class="container split"><div class="visual-card"><img src={url('/visuals/cost-accounting.svg')} width="1200" height="820" alt="Minh họa tính giá thành sản xuất và xây dựng" loading="lazy"/></div><div><span class="eyebrow">Tính giá thành</span><h2>Tập hợp chi phí, phân bổ và kiểm soát dở dang trong cùng quy trình</h2><p class="lead">Hỗ trợ doanh nghiệp sản xuất và xây dựng quản lý nguyên vật liệu, nhân công, chi phí chung, định mức và đối tượng tính giá thành.</p><div class="feature-list"><div class="feature-row"><span class="check">01</span><div><strong>Sản xuất</strong><span>Định mức, NVL, nhân công, chi phí chung và dở dang.</span></div></div><div class="feature-row"><span class="check">02</span><div><strong>Xây dựng</strong><span>Công trình, hạng mục, vật tư và tập hợp chi phí theo đối tượng.</span></div></div><div class="feature-row"><span class="check">AI</span><div><strong>Hỗ trợ phân tích</strong><span>Đề xuất định mức, đối chiếu và cảnh báo chênh lệch cần kiểm tra.</span></div></div></div><a class="btn btn-primary" href={url('/nghiep-vu/gia-thanh/')}>KHÁM PHÁ GIÁ THÀNH</a></div></div></section>

<section class="section"><div class="container"><div class="quote-band"><div><span class="eyebrow" style="color:#7fe2ba">UNESCO XI + AI</span><h2>Một nền tảng để giới thiệu, dùng thử, tải phần mềm và tiếp cận hỗ trợ.</h2><p>Website V1 kết nối Product Center, Download Center, Release Notes, hướng dẫn và biểu mẫu tư vấn trên cùng hệ thống nội dung.</p></div><div class="actions"><a class="btn btn-primary" href={url('/download/')}>TẢI PHẦN MỀM</a><a class="btn btn-secondary" href={url('/huong-dan/')}>XEM HƯỚNG DẪN</a></div></div></div></section>

<section class="section surface"><div class="container"><span class="eyebrow">FAQ</span><h2>Câu hỏi thường gặp</h2><div class="faq"><details><summary>AI có tự ghi sổ hoàn toàn không?</summary><p>Website mô tả AI theo nguyên tắc phân tích và đề xuất. Người dùng kiểm tra và phê duyệt các nghiệp vụ cần kiểm soát trước khi ghi nhận.</p></details><details><summary>UNESCO xử lý được hóa đơn và sổ phụ ở định dạng nào?</summary><p>Phạm vi hỗ trợ được công bố theo từng phiên bản. Nhóm tính năng hiện được thiết kế cho XML, Excel, PDF, ảnh và các nguồn dữ liệu ngân hàng phù hợp.</p></details><details><summary>Có hỗ trợ doanh nghiệp sản xuất và xây dựng?</summary><p>Có landing page riêng cho sản xuất, xây dựng và nghiệp vụ giá thành, với quy trình tập hợp chi phí theo đối tượng.</p></details><details><summary>Tôi có thể nâng cấp từ phiên bản UNESCO cũ?</summary><p>Chính sách nâng cấp, khả năng chuyển đổi dữ liệu và yêu cầu kỹ thuật sẽ được công bố theo từng phiên bản phát hành chính thức.</p></details></div></div></section>
<section class="section"><div class="container"><LeadForm kind="demo" heading="Muốn xem UNESCO XI + AI xử lý dữ liệu kế toán thực tế?"/></div></section>
</BaseLayout>
