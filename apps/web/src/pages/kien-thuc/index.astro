---
import { url } from '../../utils/url';
import ContentLayout from '../../layouts/ContentLayout.astro';
import Icon from '../../components/Icon.astro';
const cats=[['book-open','Kế toán','Nghiệp vụ, quy trình kiểm soát số liệu và hướng dẫn thực hành.','/huong-dan/#truc-quan'],['receipt','Hóa đơn điện tử','Đọc dữ liệu, kiểm tra hóa đơn và các tình huống nghiệp vụ liên quan.','/ai-ke-toan/ai-hoa-don/'],['bank','Ngân hàng','Sổ phụ, đối chiếu giao dịch, công nợ và xử lý nội dung chuyển khoản.','/ai-ke-toan/ai-so-phu-ngan-hang/'],['calculator','Giá thành','Sản xuất, xây dựng, định mức, phân bổ và dở dang.','/ai-ke-toan/ai-gia-thanh/'],['bot','AI kế toán','Cách AI phân tích, mức tin cậy và nguyên tắc người dùng phê duyệt.','/an-toan-kiem-soat-ai/'],['file-text','Cập nhật sản phẩm','Có gì mới, thay đổi phiên bản và hướng dẫn nâng cấp.','/release-notes/']];
---
<ContentLayout title="Trung tâm kiến thức kế toán" description="Nội dung theo chủ đề kế toán, hóa đơn, ngân hàng, giá thành và AI kế toán. Bài viết đang được biên soạn; mỗi bài sẽ ghi nguồn và ngày cập nhật." eyebrow="Trung tâm kiến thức">
<section class="section"><div class="container"><div class="grid grid-3">{cats.map(c=><a class="card" href={url(c[3])}><div class="icon"><Icon name={c[0]} /></div><h3>{c[1]}</h3><p class="muted">{c[2]}</p><strong class="link-arrow">Xem</strong></a>)}</div><div class="notice" style="margin-top:28px"><strong>Chuẩn biên tập:</strong> bài viết pháp lý/thuế phải ghi ngày cập nhật và nguồn tham chiếu; không dùng nội dung cũ như kết luận cho quy định mới.</div></div></section>
</ContentLayout>
