---
import { url } from '../../../utils/url';
import ContentLayout from '../../../layouts/ContentLayout.astro';
import Screenshot from '../../../components/Screenshot.astro';
import { shots } from '../../../data/screenshots';
import Icon from '../../../components/Icon.astro';
const multi = [
  ['layers', 'Bảng điều hành khách hàng', 'Mỗi dòng một bộ sổ: chứng từ đến tháng nào, hoá đơn / sổ phụ chưa hạch toán, tháng đã khoá, điểm sẵn sàng.', 'g'],
  ['calendar-clock', 'Chạy hàng loạt qua đêm', 'Rà từng sổ (chỉ đọc) theo giờ hẹn; sáng ra có bảng đỏ / vàng / xanh và việc cần làm cho từng sổ.', 'b'],
  ['list-checks', 'Quản lý công việc', 'Lịch thuế, BCTC, BHXH, KPCĐ, lao động theo tháng – quý – năm; việc thực tế đã xong / còn phải làm.', 't'],
  ['settings', 'Bộ tham số năm', 'Lương tối thiểu, BHXH, giảm trừ gia cảnh, thuế suất theo ngày hiệu lực – dùng chung mọi báo cáo.', 'y'],
];
---
<ContentLayout title="Giải pháp UNESCO AI cho kế toán dịch vụ" description="Một đội ngũ kế toán, nhiều doanh nghiệp, nhiều nguồn chứng từ — nhưng một quy trình xử lý và kiểm soát thống nhất." eyebrow="Giải pháp theo mô hình">
<section class="section"><div class="container split reverse"><div><Screenshot shot={shots.autoProcess} /></div><div><span class="eyebrow">Kế toán dịch vụ</span><h2>Giảm thời gian nhập lặp để tập trung vào kiểm tra và tư vấn</h2><p class="lead">Website định vị UNESCO AI như công cụ hỗ trợ xử lý khối lượng hóa đơn, sổ phụ và dữ liệu kế toán lớn ở nhiều doanh nghiệp mà vẫn giữ từng đơn vị độc lập.</p><div class="feature-list"><div class="feature-row"><span class="check">✓</span><div><strong>Nhiều doanh nghiệp</strong><span>Tổ chức công việc theo từng đơn vị, kỳ kế toán và nguồn dữ liệu.</span></div></div><div class="feature-row"><span class="check">✓</span><div><strong>Xử lý hàng loạt</strong><span>Hóa đơn và sổ phụ được đưa vào cùng quy trình phân tích – kiểm tra.</span></div></div><div class="feature-row"><span class="check">✓</span><div><strong>Kiểm soát trước báo cáo</strong><span>Đề xuất AI phải đi qua người phụ trách trước khi hoàn thiện sổ sách.</span></div></div></div><a class="btn btn-primary" href={url('/lien-he/#demo')}>DEMO CHO KẾ TOÁN DỊCH VỤ</a></div></div></section>
<section class="section surface-soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Quy trình đề xuất</span><h2>Từ nhận dữ liệu khách hàng đến bộ sổ hoàn chỉnh</h2></div><p>Từng bước có thể phân công cho nhân sự khác nhau nhưng vẫn dùng cùng nguyên tắc kiểm soát dữ liệu.</p></div><div class="process-grid"><div class="process-step"><span class="num">01</span><strong>Nhận dữ liệu</strong><small>Hóa đơn, ngân hàng, danh mục.</small></div><div class="process-step"><span class="num">02</span><strong>Phân tích AI</strong><small>Chuẩn hóa và tạo gợi ý.</small></div><div class="process-step"><span class="num">03</span><strong>Phân loại</strong><small>Mua vào, bán ra, tiền, công nợ.</small></div><div class="process-step"><span class="num">04</span><strong>Kế toán xử lý</strong><small>Duyệt và điều chỉnh khi cần.</small></div><div class="process-step"><span class="num">05</span><strong>Kiểm soát</strong><small>Đối chiếu trước khi khóa số liệu.</small></div><div class="process-step"><span class="num">06</span><strong>Báo cáo</strong><small>Sổ sách và báo cáo theo phạm vi phiên bản.</small></div></div></div></section>
<section class="section"><div class="container">
  <div class="section-head"><div><span class="eyebrow">Mới · GĐ154 – GĐ158</span><h2 class="display"><span class="tg">Một người,</span> <span class="tb">nhiều bộ sổ</span></h2></div><p>Dành cho kế toán dịch vụ làm nhiều công ty: biết ngay sổ nào đang chậm, việc nào sắp đến hạn.</p></div>
  <div class="grid grid-4">{multi.map((m) => <div class={`card top-${m[3]}`}><span class={`ic ${m[3]}`} style="margin-bottom:14px"><Icon name={m[0]} /></span><h3>{m[1]}</h3><p class="muted" style="margin:0">{m[2]}</p></div>)}</div>
  <div class="actions" style="margin-top:24px"><a class="btn btn-primary" href={url('/lien-he/#demo')}>Xem demo cho kế toán dịch vụ</a><a class="btn btn-secondary" href={url('/tinh-nang-uu-viet/#nhieu-bo-so')}>Tính năng ưu việt</a></div>
</div></section>
</ContentLayout>
