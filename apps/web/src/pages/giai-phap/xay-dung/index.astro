---
import { url } from '../../../utils/url';
import ContentLayout from '../../../layouts/ContentLayout.astro';
const cards = [["Công trình/hạng mục", "Phân loại và tập hợp chi phí theo đối tượng.", "#"], ["Vật tư và chi phí", "Đối chiếu phát sinh và phân bổ.", "#"], ["Báo cáo", "Theo dõi kết quả theo phạm vi dữ liệu được ghi nhận.", "#"]];
---
<ContentLayout title="Giải pháp kế toán cho doanh nghiệp xây dựng" description="Theo dõi công trình, hạng mục, vật tư, chi phí và giá thành theo đối tượng.">
<section class="section"><div class="container"><div class="grid grid-3">{cards.map(c => c[2] === "#" ? <div class="card"><h3>{c[0]}</h3><p class="muted">{c[1]}</p></div> : <a class="card" href={url(c[2])}><h3>{c[0]}</h3><p class="muted">{c[1]}</p><strong style="color:var(--primary)">Xem thêm →</strong></a>)}</div></div></section>
<section class="section surface"><div class="container"><div class="notice"><strong>Nguyên tắc kiểm soát:</strong> nội dung website chỉ mô tả tính năng đã được công bố theo phiên bản; AI tạo phân tích/gợi ý và người dùng kiểm tra trước các nghiệp vụ cần phê duyệt.</div><div class="actions" style="margin-top:24px"><a class="btn btn-primary" href={url('/lien-he/#demo')}>ĐĂNG KÝ XEM DEMO</a><a class="btn btn-secondary" href={url('/lien-he/')}>NHẬN TƯ VẤN</a></div></div></section>
</ContentLayout>
