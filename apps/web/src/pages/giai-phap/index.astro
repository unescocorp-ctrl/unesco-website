---
import { url } from '../../utils/url';
import ContentLayout from '../../layouts/ContentLayout.astro';
import Screenshot from '../../components/Screenshot.astro';
import Icon from '../../components/Icon.astro';
import { shots } from '../../data/screenshots';
import { industries } from '../../data/design';
const [first, ...rest] = industries;
---
<ContentLayout title="Giải pháp kế toán theo ngành" description="Một nền tảng, nhiều bối cảnh: UNESCO AI cho kế toán dịch vụ, doanh nghiệp, thương mại, bán lẻ, thương mại điện tử, sản xuất và xây dựng — cùng một phần mềm, bộ sổ riêng từng đơn vị, cùng một quy trình AI hỗ trợ, kế toán quyết định." eyebrow="Giải pháp UNESCO AI" display="GIẢI PHÁP |THEO NGÀNH" tone="ng" subtitle="Một nền tảng, nhiều bối cảnh">

<section class="section"><div class="container">
  <div class="month narrow">
    <div class="month-side">
      <div class="card"><span class="ic sm g"><Icon name="target" /></span><b>Nhóm đối tượng</b></div>
      <div class="card"><span class="ic sm t"><Icon name="settings" /></span><b>Luồng xử lý theo nghiệp vụ</b></div>
      <div class="card"><span class="ic sm b"><Icon name="layers" /></span><b>Một nền tảng, nhiều bối cảnh</b></div>
    </div>
    <div class="ind-grid two">
      <a class={`ind wide c-${first.c}`} href={url(first.href)}><span class={`ic ${first.c}`}><Icon name={first.icon} /></span><div><h3>{first.t}</h3><p>{first.d}</p></div></a>
      {rest.map((s) => <a class={`ind c-${s.c}`} href={url(s.href)}><span class={`ic ${s.c}`}><Icon name={s.icon} /></span><div><h3>{s.t}</h3><p>{s.d}</p></div></a>)}
    </div>
  </div>
</div></section>

<section class="section surface"><div class="container split"><div><Screenshot shot={shots.mainScreen} /></div><div>
  <span class="eyebrow">Cùng một phần mềm, bộ sổ riêng từng đơn vị</span><h2>Mỗi doanh nghiệp – mỗi năm tài chính một bộ sổ riêng</h2>
  <p class="lead">Gồm 9 phân hệ kế toán và màn hình AI 8 thẻ, dùng chung cho mọi ngành. Khác nhau ở danh mục, quy tắc hạch toán, định mức và báo cáo cần dùng.</p>
  <ul class="checks"><li>Thương mại – bán lẻ: gộp hoá đơn máy tính tiền, công nợ kèm VietQR, tờ khai hải quan</li><li>Sản xuất: định mức nguyên vật liệu (NVL), định mức tự động, Cân đối AI</li><li>Xây dựng: giá thành theo đối tượng, phân bổ chi phí vào các tài khoản chi tiết của TK 154 (1541, 1542, 1543)</li><li>Kế toán dịch vụ: nhiều bộ sổ, một quy trình tải hoá đơn – đọc sổ phụ</li></ul>
  <div class="actions" style="margin-top:22px"><a class="btn btn-primary" href={url('/lien-he/#demo')}>Tư vấn theo ngành</a><a class="btn btn-secondary" href={url('/bang-gia/')}>Bảng giá</a></div>
</div></div></section>
</ContentLayout>
