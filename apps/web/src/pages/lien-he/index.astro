---
import { url } from '../../utils/url';
import ContentLayout from '../../layouts/ContentLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import Icon from '../../components/Icon.astro';
import { site, show, isPlaceholder } from '../../config/site.config';
import { contact, telHref, zaloHref, mapsHref, mailHref } from '../../data/contact';
const official = 'Cập nhật theo hồ sơ chính thức';
const legal = [
  ['shield-lock', 'Bảo vệ dữ liệu', '/legal/data-protection/'],
  ['refresh', 'Hoàn trả / Huỷ dịch vụ', '/legal/refund/'],
  ['truck', 'Giao nhận / Cung cấp phần mềm', '/legal/delivery/'],
  ['headset', 'Bảo hành – hỗ trợ', '/legal/warranty-support/'],
  ['alert', 'Tiếp nhận khiếu nại', '/legal/complaints/'],
  ['file-text', 'Điều khoản sử dụng', '/legal/terms/'],
  ['lock', 'Chính sách bảo mật', '/legal/privacy/'],
  ['wallet', 'Thanh toán', '/legal/payment/'],
  ['award', 'Bản quyền & lịch sử', '/ban-quyen/'],
  ['shield-check', 'An toàn & kiểm soát AI', '/an-toan-kiem-soat-ai/'],
];
---
<ContentLayout title="Liên hệ – Hỗ trợ – Pháp lý" description="Liên hệ bộ phận kinh doanh, hỗ trợ sử dụng UNESCO AI; đăng ký demo, nhận báo giá; chính sách bảo vệ dữ liệu, hoàn trả, giao nhận, bảo hành và tiếp nhận khiếu nại." eyebrow="Báo cáo năng lực kế toán AI" display="CONTACT / SUPPORT / |LEGAL" subtitle="Liên hệ – Hỗ trợ – Thông tin pháp lý" pills={[]}>

<section class="section"><div class="container">
  <div class="csl">
    <div class="card"><span class="ic lg ring g"><Icon name="user" /></span><div><h3>Liên hệ chúng tôi</h3><p>Để lại thông tin, chúng tôi sẽ liên hệ và tư vấn trong thời gian sớm nhất.</p></div></div>
    <div class="card"><span class="ic lg ring t"><Icon name="headset" /></span><div><h3>Hỗ trợ khách hàng</h3><p>Luôn sẵn sàng hỗ trợ và giải đáp mọi thắc mắc khi sử dụng phần mềm.</p></div></div>
    <div class="card"><span class="ic lg ring b"><Icon name="scale" /></span><div><h3>Thông tin pháp lý</h3><p>Các chính sách và điều khoản áp dụng khi sử dụng dịch vụ UNESCO AI.</p></div></div>
  </div>
</div></section>

<section class="section surface"><div class="container"><div class="grid grid-2" style="align-items:start">
  <LeadForm kind="demo" heading="Đăng ký xem demo / nhận tư vấn"/>
  <div>
    <div class="info-cols one">
      <div class="col">
        <h3>Thông tin liên hệ</h3>
        <div class="info-line"><span class="ic"><Icon name="phone" /></span><div><b><a href={telHref(contact.sales.mobile)}>{contact.sales.mobile}</a></b><br/><span>Kinh doanh · <a href={telHref(contact.sales.phone)}>{contact.sales.phone}</a> ({contact.sales.ext})</span></div></div>
        <div class="info-line"><span class="ic"><Icon name="headset" /></span><div><b><a href={telHref(contact.support.phone)}>{contact.support.phone}</a></b><br/><span>Hỗ trợ sử dụng ({contact.support.ext})</span></div></div>
        <div class="info-line"><span class="ic"><Icon name="chat" /></span><div><b><a href={zaloHref} target="_blank" rel="noopener">Zalo {contact.zalo}</a></b></div></div>
        <div class="info-line"><span class="ic"><Icon name="mail" /></span><div><b><a href={mailHref}>{contact.email}</a></b></div></div>
        <div class="info-line"><span class="ic"><Icon name="map-pin" /></span><div><span>{contact.address}</span><br/><a href={mapsHref} target="_blank" rel="noopener"><strong class="tg">Xem bản đồ →</strong></a></div></div>
        <div class="info-line"><span class="ic"><Icon name="globe" /></span><div><b><a href={contact.website}>{contact.websiteLabel}</a></b></div></div>
      </div>
      <div class="col">
        <h3 class="tb">Thông tin pháp lý</h3>
        <div class="info-line b"><span class="ic"><Icon name="building" /></span><div><b>{show(site.company.legalName, official)}</b><br/><span>Đơn vị phát triển</span></div></div>
        <div class="info-line b"><span class="ic"><Icon name="file-text" /></span><div><span>Mã số thuế: {isPlaceholder(site.company.taxCode) ? official : site.company.taxCode}</span></div></div>
        <div class="info-line b"><span class="ic"><Icon name="map-pin" /></span><div><span>Địa chỉ đăng ký: {show(site.company.registeredAddress, official)}</span></div></div>
      </div>
    </div>
    <div class="callout y" style="margin-top:18px"><span class="ic"><Icon name="clipboard-check" /></span><div><h3>Thông tin pháp lý cần đối soát hồ sơ chính thức</h3><p>Mã số thuế và địa chỉ đăng ký chỉ công bố sau khi đối chiếu giấy chứng nhận đăng ký doanh nghiệp.</p></div></div>
  </div>
</div></div></section>

<section class="section"><div class="container">
  <div class="section-head"><div><span class="eyebrow">Chính sách</span><h2>Pháp lý & hỗ trợ khách hàng</h2></div><p>Các chính sách áp dụng khi mua, cài đặt và sử dụng phần mềm UNESCO AI.</p></div>
  <div class="legal-links">{legal.map((l) => <a href={url(l[2])}><Icon name={l[0]} />{l[1]}</a>)}</div>
</div></section>
</ContentLayout>
