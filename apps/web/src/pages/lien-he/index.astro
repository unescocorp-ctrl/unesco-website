---
import ContentLayout from '../../layouts/ContentLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site, show, isPlaceholder } from '../../config/site.config';
---
<ContentLayout title="Liên hệ & Đăng ký demo" description="Gửi yêu cầu tư vấn, xem demo hoặc yêu cầu báo giá UNESCO XI + AI."><section class="section"><div class="container grid grid-2"><div><span class="eyebrow">Thông tin liên hệ</span><h2>Trao đổi trực tiếp với bộ phận phụ trách</h2><div class="card"><p><strong>Đơn vị:</strong> {show(site.company.legalName)}</p><p><strong>Điện thoại:</strong> {show(site.company.phone)}</p><p><strong>Di động/Zalo:</strong> {show(site.company.mobile)} / {show(site.company.zalo)}</p><p><strong>Email:</strong> {show(site.company.email)}</p><p><strong>Địa chỉ:</strong> {show(site.company.contactAddress)}</p></div>{isPlaceholder(site.company.phone) && <div class="notice" style="margin-top:18px">Thông tin liên hệ chính thức đang được cập nhật.</div>}</div><LeadForm kind="demo" heading="Đăng ký xem demo"/></div></section></ContentLayout>
