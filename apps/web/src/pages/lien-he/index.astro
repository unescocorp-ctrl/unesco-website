---
import { url } from '../../utils/url';
import ContentLayout from '../../layouts/ContentLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site, show, isPlaceholder } from '../../config/site.config';
import { contact, telHref, zaloHref, mapsHref, mailHref } from '../../data/contact';
---
<ContentLayout title="Liên hệ & Đăng ký demo" description="Liên hệ bộ phận kinh doanh, hỗ trợ sử dụng UNESCO XI + AI; đăng ký demo hoặc nhận báo giá.">
<section class="section"><div class="container">
  <div class="contact-cards">
    <div class="contact-card"><div class="icon">📞</div><h3>{contact.sales.label}</h3><p>Tư vấn, báo giá, đăng ký demo, nhận bộ cài.</p><a class="big" href={telHref(contact.sales.mobile)}>{contact.sales.mobile}</a><p><a href={telHref(contact.sales.phone)}>{contact.sales.phone}</a> · {contact.sales.ext}</p><p><a href={zaloHref} target="_blank" rel="noopener"><strong>Chat Zalo {contact.zalo}</strong></a></p></div>
    <div class="contact-card"><div class="icon">🛠️</div><h3>{contact.support.label}</h3><p>Hướng dẫn thao tác, xử lý số liệu, cập nhật phiên bản.</p><a class="big" href={telHref(contact.support.phone)}>{contact.support.phone}</a><p>{contact.support.ext}</p><p><a href={url('/ho-tro/')}><strong>Gửi yêu cầu hỗ trợ →</strong></a></p></div>
    <div class="contact-card"><div class="icon">✉️</div><h3>Email & văn phòng</h3><p>Gửi tài liệu, yêu cầu báo giá bằng văn bản.</p><a class="big" style="font-size:1.1rem;word-break:break-all" href={mailHref}>{contact.email}</a><p>{contact.address}</p><p><a href={mapsHref} target="_blank" rel="noopener"><strong>Xem bản đồ →</strong></a></p></div>
  </div>
  <div class="grid grid-2" style="margin-top:34px;align-items:start">
    <div><span class="eyebrow">Đơn vị</span><h2>Trao đổi trực tiếp với bộ phận phụ trách</h2><div class="card"><p><strong>Đơn vị:</strong> {show(site.company.legalName)}</p><p><strong>Kinh doanh:</strong> {contact.sales.mobile} · {contact.sales.phone} ({contact.sales.ext})</p><p><strong>Hỗ trợ sử dụng:</strong> {contact.support.phone} ({contact.support.ext})</p><p><strong>Email:</strong> {contact.email}</p><p><strong>Địa chỉ:</strong> {contact.address}</p><p><strong>Website:</strong> <a href={contact.website}>{contact.websiteLabel}</a></p></div>{!isPlaceholder(site.company.taxCode) && <p class="caption" style="margin-top:12px">MST: {site.company.taxCode}</p>}</div>
    <LeadForm kind="demo" heading="Đăng ký xem demo"/>
  </div>
</div></section>
</ContentLayout>
