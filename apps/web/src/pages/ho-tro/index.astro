---
import { url } from '../../utils/url';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { site, isPlaceholder } from '../../config/site.config';
const supportEmail = isPlaceholder(site.company.supportEmail) ? (isPlaceholder(site.company.email) ? '' : site.company.email) : site.company.supportEmail;
---
<ContentLayout title="Trung tâm hỗ trợ" description="Hướng dẫn, câu hỏi thường gặp, lịch sử cập nhật và kênh gửi yêu cầu hỗ trợ UNESCO AI.">
<section class="section"><div class="container grid grid-2"><div><div class="grid"><a class="card" href={url('/huong-dan/')}><h3>Hướng dẫn</h3><p class="muted">Tra cứu theo nghiệp vụ.</p></a><a class="card" href={url('/release-notes/')}><h3>Có gì mới</h3><p class="muted">Phiên bản và lỗi đã sửa.</p></a><a class="card" href={url('/download/')}><h3>Trung tâm tải về</h3><p class="muted">Nhận bộ cài qua điện thoại hoặc Zalo.</p></a></div></div><div class="card"><h2 style="font-size:2rem">Gửi yêu cầu hỗ trợ</h2><p class="muted">Khi liên hệ, cho biết số bản GĐ đang cài, gửi ảnh màn hình thông báo lỗi và nói rõ đang ở thẻ nào của màn hình AI. Không đăng ảnh có mã số thuế hay tên khách hàng lên chỗ công khai.</p><form id="support-form"><div class="form-grid"><div class="field"><label>Họ tên *</label><input name="fullName" required maxlength="120"/></div><div class="field"><label>Doanh nghiệp</label><input name="companyName" maxlength="200"/></div><div class="field"><label>Điện thoại *</label><input name="phone" required maxlength="30" placeholder="Ví dụ: 0912 345 678"/></div><div class="field"><label>Email</label><input name="email" type="email" maxlength="200"/></div><div class="field"><label>Sản phẩm *</label><input name="productCode" value="UNESCO_XI_AI" required maxlength="60"/></div><div class="field"><label>Phiên bản</label><input name="version" maxlength="40" placeholder="Ví dụ: GĐ178"/></div><div class="field full"><label>Tiêu đề *</label><input name="subject" required maxlength="200"/></div><div class="field full"><label>Mô tả *</label><textarea name="description" required maxlength="4000" placeholder="Cho biết bước đã làm, thông báo lỗi, thời điểm xảy ra; đính kèm ảnh nếu có."></textarea></div></div><button class="btn btn-primary" style="margin-top:18px" type="submit">GỬI YÊU CẦU</button><div class="form-status" role="status" aria-live="polite"></div></form></div></div></section>
<script is:inline define:vars={{ apiBase: site.apiUrl, supportEmail }}>
const f=document.getElementById('support-form');f?.addEventListener('submit',async e=>{e.preventDefault();const s=f.querySelector('.form-status');const body=Object.fromEntries(new FormData(f).entries());
if(!apiBase){
  if(supportEmail){
    const text=['Họ tên: '+(body.fullName||''),'Doanh nghiệp: '+(body.companyName||''),'Điện thoại: '+(body.phone||''),'Email: '+(body.email||''),'Sản phẩm: '+(body.productCode||''),'Phiên bản: '+(body.version||''),'','Mô tả:',(body.description||'')].join('\n');
    location.href='mailto:'+supportEmail+'?subject='+encodeURIComponent('[Hỗ trợ] '+(body.subject||''))+'&body='+encodeURIComponent(text);
    s.textContent='Đã mở ứng dụng email để bạn gửi yêu cầu hỗ trợ.';
  } else {
    s.textContent='Kênh gửi yêu cầu trực tuyến đang được cập nhật. Vui lòng liên hệ bộ phận hỗ trợ qua thông tin tại trang Liên hệ.';
  }
  return;
}
s.textContent='Đang gửi...';
try{const r=await fetch(`${apiBase}/support-requests`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(!r.ok)throw new Error();const j=await r.json();s.textContent=`Đã tiếp nhận. Mã yêu cầu: ${j.ticketCode}`;f.reset();}catch{s.textContent='Chưa gửi được yêu cầu. Vui lòng dùng thông tin liên hệ chính thức trên website.';}});
</script>
</ContentLayout>
