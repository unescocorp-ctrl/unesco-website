---
import ContentLayout from '../../layouts/ContentLayout.astro';
---
<ContentLayout title="Trung tâm hỗ trợ" description="Hướng dẫn, FAQ, release notes và kênh gửi yêu cầu hỗ trợ UNESCO XI + AI.">
<section class="section"><div class="container grid grid-2"><div><div class="grid"><a class="card" href="/huong-dan/"><h3>Hướng dẫn</h3><p class="muted">Tra cứu theo nghiệp vụ.</p></a><a class="card" href="/release-notes/"><h3>Release Notes</h3><p class="muted">Phiên bản và lỗi đã sửa.</p></a><a class="card" href="/download/"><h3>Download Center</h3><p class="muted">Tải file đã xác minh SHA-256.</p></a></div></div><div class="card"><h2 style="font-size:2rem">Gửi yêu cầu hỗ trợ</h2><form id="support-form"><div class="form-grid"><div class="field"><label>Họ tên *</label><input name="fullName" required maxlength="120"/></div><div class="field"><label>Doanh nghiệp</label><input name="companyName" maxlength="200"/></div><div class="field"><label>Điện thoại *</label><input name="phone" required maxlength="30"/></div><div class="field"><label>Email</label><input name="email" type="email" maxlength="200"/></div><div class="field"><label>Sản phẩm *</label><input name="productCode" value="UNESCO_XI_AI" required maxlength="60"/></div><div class="field"><label>Phiên bản</label><input name="version" maxlength="40"/></div><div class="field full"><label>Tiêu đề *</label><input name="subject" required maxlength="200"/></div><div class="field full"><label>Mô tả *</label><textarea name="description" required maxlength="4000"></textarea></div></div><button class="btn btn-primary" style="margin-top:18px" type="submit">GỬI YÊU CẦU</button><div class="form-status" role="status" aria-live="polite"></div></form></div></div></section>
</ContentLayout>
<script is:inline define:vars={{apiBase: import.meta.env.PUBLIC_API_URL || 'http://localhost:5000/api/v1'}}>
const f=document.getElementById('support-form');f?.addEventListener('submit',async e=>{e.preventDefault();const s=f.querySelector('.form-status');s.textContent='Đang gửi...';const body=Object.fromEntries(new FormData(f).entries());try{const r=await fetch(`${apiBase}/support-requests`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(!r.ok)throw new Error();const j=await r.json();s.textContent=`Đã tiếp nhận. Mã yêu cầu: ${j.ticketCode}`;f.reset();}catch{s.textContent='Chưa gửi được yêu cầu. Vui lòng dùng thông tin liên hệ chính thức trên website.';}});
</script>
