---
import { url } from '../../utils/url';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { videos, videoTopics, topicSlug } from '../../data/videos';
import { contact, telHref } from '../../data/contact';
const icons: Record<string, string> = { 'Tổng quan': '🚀', 'Hoá đơn & chứng từ': '🧾', 'Ngân hàng & công nợ': '🏦', 'Báo cáo & thuế': '📊', 'Giá thành': '🏭', 'Trợ lý AI': '🤖' };
---
<ContentLayout title="Hướng dẫn sử dụng UNESCO AI" description="Trung tâm hướng dẫn phần mềm kế toán UNESCO AI theo nghiệp vụ: video từng module, quy trình bắt đầu sử dụng và kênh hỗ trợ trực tiếp." eyebrow="Help Center">
<section class="section"><div class="container"><div class="grid grid-3">{videoTopics.map((t) => (
  <a class="card" href={url(`/video/#${topicSlug(t)}`)}><div class="icon">{icons[t]}</div><h3>{t}</h3><ul class="checks" style="margin-top:12px">{videos.filter((v) => v.topic === t).map((v) => <li>{v.title} <span class="caption">({v.duration})</span></li>)}</ul><strong class="link-arrow" style="margin-top:14px">Xem video</strong></a>
))}</div></div></section>
<section class="section surface-soft"><div class="container"><div class="grid grid-3">
  <a class="card" href={url('/download/')}><div class="icon">⬇️</div><h3>Cài đặt & bắt đầu</h3><p class="muted">Yêu cầu hệ thống và các bước từ cài đặt đến báo cáo đầu tiên.</p><strong class="link-arrow">Xem các bước</strong></a>
  <a class="card" href={url('/ai-ke-toan/')}><div class="icon">✨</div><h3>Dùng màn hình AI</h3><p class="muted">Quy trình xử lý tự động, bốn ô kiểm soát và trợ lý AI trên màn hình.</p><strong class="link-arrow">Xem hướng dẫn</strong></a>
  <a class="card" href={url('/ho-tro/')}><div class="icon">🛠️</div><h3>Gửi yêu cầu hỗ trợ</h3><p class="muted">Ghi rõ phiên bản và thao tác đang làm để được hỗ trợ nhanh.</p><strong class="link-arrow">Gửi yêu cầu</strong></a>
</div></div></section>
<section class="section"><div class="container"><div class="quote-band"><div><h2>Cần hướng dẫn trực tiếp?</h2><p>Hỗ trợ sử dụng: {contact.support.phone} ({contact.support.ext}).</p></div><div class="actions"><a class="btn btn-primary" href={telHref(contact.support.phone)}>GỌI HỖ TRỢ</a><a class="btn btn-secondary" href={url('/release-notes/')}>RELEASE NOTES</a></div></div></div></section>
</ContentLayout>
