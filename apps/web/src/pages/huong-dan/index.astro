---
import { url } from '../../utils/url';
import ContentLayout from '../../layouts/ContentLayout.astro';
import VideoCard from '../../components/VideoCard.astro';
import Icon from '../../components/Icon.astro';
import { videoBySlug } from '../../data/videos';
import { contact, telHref } from '../../data/contact';
import { guide, guideGroups, guideRelease, whenToUse } from '../../data/visual-guide';
import { docs } from '../../data/advantages';
const topics = [
  ['home', 'Bắt đầu', '/video/#tong-quan'],
  ['settings', 'Cài đặt', '/download/'],
  ['cart', 'Mua vào', '/video/#video-m02-tai-hoa-don'],
  ['send', 'Bán ra', '/nghiep-vu/ban-ra/'],
  ['bank', 'Ngân hàng', '/video/#video-m05-so-phu-ngan-hang'],
  ['bot', 'AI', '/video/#video-m08-tro-ly-ai'],
  ['calculator', 'Giá thành', '/video/#video-m07-gia-thanh'],
  ['bar-chart', 'Báo cáo', '/video/#video-m06-bao-cao-nhat-ky'],
  ['refresh', 'Cập nhật', '/release-notes/'],
  ['wrench', 'Khắc phục lỗi', '/ho-tro/'],
];
const center = [
  ['m04-tu-dong-xu-ly', 'AI'], ['m02-tai-hoa-don', 'Hoá đơn'], ['m05-so-phu-ngan-hang', 'Sổ phụ'],
  ['m07-gia-thanh', 'Giá thành'], ['m06-bao-cao-nhat-ky', 'Báo cáo'], ['to-khai-hai-quan', 'Hải quan'],
].map(([s, label]) => ({ v: videoBySlug(s)!, label }));
const know = [
  ['download', 'Cài đặt & bắt đầu', 'Yêu cầu hệ thống và 6 bước từ cài đặt đến báo cáo đầu tiên.', '/download/', 'g'],
  ['sparkles', 'Dùng màn hình AI', 'Quy trình xử lý tự động, bốn ô kiểm soát và trợ lý AI trên màn hình.', '/ai-ke-toan/', 't'],
  ['book-open', 'Kiến thức kế toán', 'Bài viết theo chủ đề hoá đơn, ngân hàng, giá thành, thuế.', '/kien-thuc/', 'b'],
  ['info', 'Câu hỏi thường gặp', 'Giải đáp nhanh về sản phẩm, AI, cài đặt, nâng cấp.', '/faq/', 'y'],
  ['history', 'Release notes', 'Lịch sử phiên bản và có gì mới theo từng gói.', '/release-notes/', 'g'],
  ['list-checks', 'Tổng hợp 65 tính năng AI', 'Mỗi tính năng làm gì, mở từ menu / nút nào.', '/tinh-nang-ai/', 't'],
  ['star', 'Tính năng ưu việt', '16 điểm ưu việt và số liệu đo thực tế.', '/tinh-nang-uu-viet/', 'y'],
  ['headset', 'Gửi yêu cầu hỗ trợ', 'Ghi rõ phiên bản và thao tác đang làm để được hỗ trợ nhanh.', '/ho-tro/', 'b'],
];
---
<ContentLayout title="Guide / Knowledge / Video Center – Hướng dẫn UNESCO AI" description="Trung tâm hướng dẫn phần mềm kế toán UNESCO AI: video từng module quay trên phần mềm thật, kiến thức kế toán, câu hỏi thường gặp, release notes và kênh hỗ trợ trực tiếp." eyebrow="Help Center" display="GUIDE / KNOWLEDGE / |VIDEO CENTER" subtitle="Học từng thao tác theo đúng việc bạn cần làm">

<section class="section"><div class="container">
  <nav class="topic-bar" aria-label="Chủ đề hướng dẫn">{topics.map((t, i) => <a class={i === 0 ? 'on' : ''} href={url(t[2])}><Icon name={t[0]} />{t[1]}</a>)}</nav>
  <div class="video-grid">{center.map((c) => <div><p class="sub-line" style="margin:0 0 10px">{c.label}</p><VideoCard video={c.v} /></div>)}</div>
  <div class="actions" style="margin-top:26px"><a class="btn btn-primary" href={url('/video/')}><Icon name="play-circle" />Tất cả video</a></div>
</div></section>

<section class="section surface-soft" id="truc-quan"><div class="container">
  <div class="section-head"><div><span class="eyebrow">Hướng dẫn trực quan · GĐ150 – GĐ174 · bản {guideRelease.code}</span><h2>{guide.length} chức năng mới: mở ở đâu, bấm nút nào</h2></div><p>Mỗi chức năng một trang có hình màn hình đánh số, các bước và lưu ý. Các báo cáo mới chỉ đọc sổ; ghi sổ hoặc chép vào HTKK chỉ khi kế toán bấm Ghi, Đồng ý, Đưa vào HTKK. Ở bất kỳ màn hình nào, bấm F1 để Trợ lý AI mở đúng mục hướng dẫn.</p></div>
  <h3>Dùng vào lúc nào trong năm</h3>
  <div class="when6" style="margin:12px 0 26px">{whenToUse.map((w) => <div><b>{w.t}</b><small>{w.d}</small></div>)}</div>
  <nav class="cat-nav" aria-label="Nhóm chức năng">{guideGroups.map((gr) => <a href={`#nhom-${gr.id}`}><span>{guide.filter((g) => g.grp === gr.id).length}</span>{gr.t}</a>)}</nav>
  {guideGroups.map((gr) => (
    <div class="guide-sec" id={`nhom-${gr.id}`}>
      <div class="guide-sec-h"><h3>{gr.t}</h3><span class="code">{gr.code}</span></div>
      <div class="guide-grid">{guide.filter((g) => g.grp === gr.id).map((g) => (
        <article class="guide has-img" id={`hd-${g.n}`}>
          <a class="guide-img" href={`${url(guideRelease.pdf)}#page=${g.page}`} target="_blank" rel="noopener" aria-label={`Mở trang hướng dẫn ${g.n} trong PDF`}><img src={url(`/huong-dan/hd-${g.n}.webp`)} alt={`Hướng dẫn trực quan ${g.n} – ${g.t}: hình màn hình đánh số (số liệu mẫu)`} width="760" height="669" loading="lazy" decoding="async" /><span class="zoom">Xem trang {g.page} trong PDF</span></a>
          <div class="guide-top"><span class="n">{g.n}</span><span class="ic sm g"><Icon name={g.icon} /></span><span class="code">{g.code}</span></div>
          <h3>{g.t}</h3><p>{g.d}</p>
          <div class="crumbs">{g.path.map((x, i) => <>{i > 0 && <i>›</i>}<span>{x}</span></>)}</div>
          <ol>{g.steps.map((st) => <li>{st}</li>)}</ol>
        </article>
      ))}</div>
    </div>
  ))}
  <p class="caption" style="margin-top:14px">Hình là bố cục màn hình dựng từ chữ và hình của phần mềm; số liệu trên hình là số mẫu, không phải số của công ty nào.</p>
  <div class="doc-grid" style="margin-top:28px">{docs.map((f) => <a class="doc" href={url(f.file)} target="_blank" rel="noopener"><span class="ic g"><Icon name={f.icon} /></span><span><b>{f.t}</b><small>{f.d}</small><span class="dl-tag"><Icon name="download" />PDF · {f.size}</span></span></a>)}</div>
</div></section>

<section class="section surface"><div class="container">
  <div class="section-head"><div><span class="eyebrow">Knowledge</span><h2>Tài liệu & hỗ trợ</h2></div><p>Mỗi mục dẫn tới trang chi tiết; cần hỗ trợ trực tiếp hãy gọi bộ phận hỗ trợ sử dụng.</p></div>
  <div class="grid grid-3">{know.map((k) => <a class={`card top-${k[4]}`} href={url(k[3])}><span class={`ic ${k[4]}`} style="margin-bottom:14px"><Icon name={k[0]} /></span><h3>{k[1]}</h3><p class="muted">{k[2]}</p><strong class="link-arrow">Xem</strong></a>)}</div>
</div></section>

<section class="section"><div class="container"><div class="quote-band"><div><h2>Cần hướng dẫn trực tiếp?</h2><p>Hỗ trợ sử dụng: {contact.support.line}.</p></div><div class="actions"><a class="btn btn-primary" href={telHref(contact.support.phone)}>Gọi hỗ trợ</a><a class="btn btn-secondary" href={url('/ho-tro/')}>Gửi yêu cầu</a></div></div></div></section>
<script is:inline>
  document.addEventListener('play', function (e) {
    document.querySelectorAll('video').forEach(function (v) { if (v !== e.target) v.pause(); });
  }, true);
</script>
</ContentLayout>
