---
import { url } from '../../utils/url';
import ContentLayout from '../../layouts/ContentLayout.astro';
import Screenshot from '../../components/Screenshot.astro';
import { shots } from '../../data/screenshots';
---
<ContentLayout title="Về UNESCO AI" description="Giới thiệu định hướng sản phẩm, nguyên tắc phát triển và thông tin đơn vị sở hữu/phát triển sau khi được xác minh." eyebrow="Về sản phẩm">
<section class="section"><div class="container split"><div><span class="eyebrow">Định hướng</span><h2>Phần mềm kế toán lấy dữ liệu và khả năng kiểm soát làm trung tâm</h2><p class="lead">UNESCO AI được định vị như hệ thống kế toán có lớp hỗ trợ AI: giảm thao tác lặp lại nhưng vẫn giữ vai trò kiểm tra và quyết định nghiệp vụ của kế toán.</p><div class="feature-list"><div class="feature-row"><span class="check">1</span><div><strong>Không tự động hóa mù</strong><span>Đề xuất cần có dữ liệu tham chiếu và điểm duyệt.</span></div></div><div class="feature-row"><span class="check">2</span><div><strong>Không tách AI khỏi nghiệp vụ</strong><span>AI phục vụ hóa đơn, ngân hàng, công nợ, kho, giá thành và báo cáo.</span></div></div><div class="feature-row"><span class="check">3</span><div><strong>Không công bố thông tin chưa xác minh</strong><span>Pháp nhân, bản quyền, giá và số liệu thương mại chỉ công bố sau khi đối chiếu giấy tờ chính thức.</span></div></div></div></div><div><Screenshot shot={shots.mainScreen} /></div></div></section>
<section class="section surface-soft"><div class="container grid grid-3"><a class="card" href={url('/ban-quyen/')}><h3>Bản quyền & chứng nhận</h3><p class="muted">Thông tin chỉ hiển thị sau khi đối chiếu giấy tờ chính thức.</p><strong class="link-arrow">Xem khu bản quyền</strong></a><a class="card" href={url('/release-notes/')}><h3>Lịch sử phiên bản</h3><p class="muted">Theo dõi thay đổi, bản phát hành và known issues.</p><strong class="link-arrow">Xem release notes</strong></a><a class="card" href={url('/lien-he/')}><h3>Liên hệ chính thức</h3><p class="muted">Kênh tư vấn, hỗ trợ và thông tin doanh nghiệp.</p><strong class="link-arrow">Liên hệ</strong></a></div></section>
</ContentLayout>
