---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import { url } from '../../../utils/url';
import groups from '../../../data/xii-visual-guide.json';
const count = groups.reduce((n,g) => n + g.items.length, 0);
---
<ContentLayout title="Hướng dẫn UNESCO XII AI bằng ảnh chụp thật" display="MỞ ĐÚNG MÀN HÌNH. |LÀM TỪNG BƯỚC." subtitle="Hướng dẫn trực quan UNESCO XII AI" description={`10 bài hướng dẫn UNESCO XII AI với 45 ảnh chụp thật và ${count} chức năng: hóa đơn, ngân hàng, lương, báo cáo, giá thành và phối hợp dịch vụ kế toán.`} eyebrow="Ảnh phần mềm thật · cập nhật 18/11/2026" pills={['10 bài chi tiết', `${count} chức năng`, '45 ảnh mở lớn']} crumbs={[['Trang chủ','/'],['UNESCO XII AI','/unesco-xii-ai/dich-vu-ke-toan/'],['Hướng dẫn trực quan','/unesco-xii-ai/huong-dan/']]}>
  <section class="section"><div class="container intro-grid">
    <div><span class="eyebrow">Đọc theo công việc bạn cần làm</span><h2>Từ nơi mở chức năng đến kết quả cần kiểm</h2><p>Mỗi bài có đường mở màn hình, ảnh thật, vị trí cần nhìn, các bước thao tác và bảng kiểm kết quả. Kế toán phụ trách có thể dùng để thực hành; người quản lý dùng để phân công và kiểm tiến độ.</p><p>Ảnh giữ giao diện gốc, đã che thông tin riêng của doanh nghiệp, cá nhân và máy. Bấm ảnh trong bài để xem lớn hoặc xem ở kích thước 100%.</p><div class="actions"><a class="btn btn-primary" href="#chu-de">Chọn chủ đề</a><a class="btn btn-secondary" href="#tra-cuu">Tìm chức năng</a></div></div>
    <figure class="intro-image"><a href={url('/kien-thuc/huong-dan-unesco-xii-bat-dau/#man-hinh-00')}><img src={url(groups[0].items[0].image)} width="1200" height="596" alt="Màn hình chính UNESCO XII AI, thông tin riêng đã che" fetchpriority="high" /></a><figcaption>Bắt đầu từ màn hình chính UNESCO XII AI →</figcaption></figure>
  </div></section>
  <section class="section surface-soft" id="chu-de"><div class="container">
    <div class="section-head"><div><span class="eyebrow">10 chủ đề thực hành</span><h2>Hướng dẫn theo từng nhóm việc</h2></div><p>Chọn một bài để đọc liền mạch, hoặc tra thẳng đến màn hình ở phần bên dưới.</p></div>
    <div class="grid grid-2 visual-topics">{groups.map((g) => <article class="card visual-topic"><a class="topic-cover" href={url(`/kien-thuc/${g.slug}/`)} aria-label={`Đọc ${g.title}`}><img src={url(g.items[0].image)} width="1200" height="618" alt={`Ảnh thật: ${g.items[0].title}`} loading="lazy" decoding="async" /></a><div class="topic-body"><span class="eyebrow">{g.id} · {g.items.length} chức năng</span><h3><a href={url(`/kien-thuc/${g.slug}/`)}>{g.title}</a></h3><p>{g.description}</p><a class="link-arrow" href={url(`/kien-thuc/${g.slug}/`)}>Đọc các bước và xem ảnh</a></div></article>)}</div>
  </div></section>
  <section class="section" id="tra-cuu"><div class="container" data-screen-library>
    <div class="section-head"><div><span class="eyebrow">Tra cứu nhanh</span><h2>{count} chức năng: mở ở đâu?</h2></div><p>Tìm không dấu, ví dụ “ngan hang”, “bang luong” hoặc “gia thanh”. Kết quả dẫn đến đúng mục trong bài.</p></div>
    <div class="screen-filters" data-screen-controls hidden><label for="screen-search">Tên chức năng hoặc đường mở<input id="screen-search" type="search" placeholder="Ví dụ: ngân hàng, hóa đơn, định mức" autocomplete="off" /></label><label for="screen-group">Nhóm việc<select id="screen-group"><option value="all">Tất cả chủ đề</option>{groups.map(g => <option value={g.id}>{g.title}</option>)}</select></label><button class="btn btn-secondary" type="button" data-screen-reset>Xóa bộ lọc</button></div>
    <p role="status" aria-live="polite" data-screen-count>Hiển thị {count} chức năng.</p>
    <div class="screen-directory">{groups.flatMap(g => g.items.map(item => <a class="screen-entry" data-screen-entry data-group={g.id} data-search={`${g.title} ${item.title} ${item.path}`} href={`${url(`/kien-thuc/${g.slug}/`)}#${item.anchor}`}><span>{g.id} / {g.title}</span><h3>{item.title}</h3><p><strong>Mở:</strong> {item.path}</p><b>Đến hướng dẫn →</b></a>))}</div>
    <p class="notice" data-screen-empty hidden>Chưa tìm thấy chức năng phù hợp. Thử từ khóa ngắn hơn hoặc chọn tất cả chủ đề.</p>
  </div></section>
  <section class="section surface-soft"><div class="container"><div class="quote-band"><div><h2>Phối hợp cùng dịch vụ kế toán</h2><p>Xem lộ trình theo vai trò, kết nối ERP UNESCO, video minh họa, cẩm nang PDF và mẫu bàn giao hồ sơ.</p></div><a class="btn btn-primary" href={url('/unesco-xii-ai/dich-vu-ke-toan/')}>Mở chuyên mục dịch vụ kế toán</a></div><p class="caption" style="margin-top:24px">Các ảnh phản ánh phiên bản tại thời điểm chụp; quyền và cấu hình thực tế có thể khác. Đối chiếu bộ sổ, kỳ và hồ sơ nguồn trước khi ghi dữ liệu.</p></div></section>
</ContentLayout>
<script>
const library = document.querySelector<HTMLElement>('[data-screen-library]');
if (library) {
  const input = library.querySelector<HTMLInputElement>('#screen-search')!;
  const select = library.querySelector<HTMLSelectElement>('#screen-group')!;
  const entries = [...library.querySelectorAll<HTMLElement>('[data-screen-entry]')];
  const normalize = (s: string) => s.toLocaleLowerCase('vi').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d');
  function filter() {
    const words = normalize(input.value).trim().split(/\s+/).filter(Boolean); let count = 0;
    entries.forEach(entry => { const match = (select.value === 'all' || select.value === entry.dataset.group) && words.every(w => normalize(entry.dataset.search!).includes(w)); entry.hidden = !match; if(match) count++; });
    library!.querySelector('[data-screen-count]')!.textContent = `Hiển thị ${count} / ${entries.length} chức năng.`;
    library!.querySelector<HTMLElement>('[data-screen-empty]')!.hidden = count !== 0;
  }
  library.querySelector<HTMLElement>('[data-screen-controls]')!.hidden = false;
  input.addEventListener('input',filter); select.addEventListener('change',filter);
  library.querySelector('[data-screen-reset]')!.addEventListener('click',()=>{input.value='';select.value='all';filter();input.focus();});
}
</script>
<style>
.intro-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:40px;align-items:center}.intro-grid p{color:#40584d;line-height:1.8}.intro-image{margin:0}.intro-image img{display:block;width:100%;height:auto;border-radius:14px;border:1px solid #bbd3c6;box-shadow:0 16px 35px #173b2b15}.intro-image figcaption{font-size:.86rem;color:#40584d;margin-top:12px}.visual-topics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.visual-topic{padding:0;overflow:hidden}.topic-cover{display:block;background:#e9f2ed;padding:16px;border-bottom:1px solid #d5e4dc}.topic-cover img{display:block;width:100%;height:auto;aspect-ratio:1.94;object-fit:contain}.topic-body{padding:26px}.topic-body h3 a{color:inherit;text-decoration:none}.topic-body h3 a:hover{text-decoration:underline}.screen-filters{display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;background:#f0f8f4;border:1px solid #cfe4d9;border-radius:14px;padding:24px}.screen-filters label{display:grid;gap:8px;flex:1 1 240px;font-weight:700;min-width:0}.screen-filters input,.screen-filters select{font:inherit;color:#173b2b;padding:12px;width:100%;min-width:0;max-width:100%;border:1px solid #91ada0;border-radius:8px;background:white}.screen-directory{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.screen-entry{padding:22px;border:1px solid #cfe4d9;border-radius:12px;color:#173b2b;text-decoration:none;overflow-wrap:anywhere}.screen-entry:hover{background:#f0f8f4;border-color:#157a39}.screen-entry>span{font-size:.76rem;color:#426354;font-weight:700}.screen-entry h3{font-size:1.12rem;margin:10px 0}.screen-entry p{font-size:.9rem;line-height:1.6;color:#40584d}.screen-entry>b{font-size:.9rem;color:#157a39}.screen-entry[hidden],.screen-filters[hidden],[data-screen-empty][hidden]{display:none}input:focus-visible,select:focus-visible,.screen-entry:focus-visible{outline:3px solid #1679a8;outline-offset:3px}@media(max-width:800px){.intro-grid{grid-template-columns:1fr;gap:24px}.visual-topics,.screen-directory{grid-template-columns:1fr}.screen-filters{padding:18px}.topic-body{padding:22px}}
</style>
