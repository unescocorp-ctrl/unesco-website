---
import {url,absoluteUrl} from '../utils/url';
import '../styles/security-content.css';
const {title,description,noindex=false}=Astro.props;
const home='/san-pham/unesco-security/';
---
<!doctype html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | UNESCO Security</title><meta name="description" content={description}/><meta name="theme-color" content="#075bb1"/><link rel="canonical" href={absoluteUrl(Astro.url.pathname,Astro.site??"https://www.unescosoft.com")}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{noindex&&<meta name="robots" content="noindex,follow"/>}<link rel="icon" href={url('/favicon-32.png')}/></head><body><header class="sc-header"><a class="sc-brand" href={url(home)}><svg viewBox="0 160 1536 620" role="img" aria-label="UNESCO Security"><image href={url(home+'assets/logo.jpg')} width="1536" height="1024"/></svg><span>SECURITY SOFTWARE</span></a><nav aria-label="Điều hướng UNESCO Security"><a href={url(home)}>Sản phẩm</a><a href={url(home+'demo/')}>Demo trực tiếp</a><a href={url(home+'bai-viet/')}>Bài viết</a><a href={url(home+'huong-dan/')}>Hướng dẫn</a></nav></header><main><slot/></main><footer class="sc-footer"><strong>UNESCO · Tri thức cộng đồng – Kết nối thành công</strong><p><a href={url('/')}>Trang chủ unescosoft.com</a> · <a href={url('/lien-he/#demo')}>Liên hệ tư vấn</a></p><p>Demo dùng dữ liệu minh họa. Bản vận hành cần tài khoản và cấu hình riêng của đơn vị.</p></footer></body></html>
