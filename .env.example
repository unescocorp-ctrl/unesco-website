# Frontend (đọc lúc build)
# Origin website. GitHub Pages: https://<user>.github.io ; tên miền riêng: https://www.ten-mien.vn
PUBLIC_SITE_URL=https://www.example.vn
# Thư mục con. GitHub Pages project site: /<ten-repo> ; tên miền riêng: để trống
BASE_PATH=
# Để trống nếu chưa có API: form sẽ chuyển sang email/hướng dẫn liên hệ
PUBLIC_API_URL=https://api.example.vn/api/v1
PUBLIC_ANALYTICS_ID=

# API / server only
DB_CONNECTION_STRING=Server=.\\SQLEXPRESS;Database=UNESCO_WEB;Trusted_Connection=True;TrustServerCertificate=True;
ALLOWED_ORIGINS=https://www.example.vn
TURNSTILE_SECRET=
MAIL_API_SECRET=
